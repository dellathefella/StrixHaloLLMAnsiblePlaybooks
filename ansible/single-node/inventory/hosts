# =============================================================================
# hosts — SINGLE-NODE inventory (topology: one box, one model at a time)
#
# No Thunderbolt link here: there is no `multinode` group, so
# ../multi-node/setup-thunderbolt-net.yml can never match anything in this file.
# The 2-node TB4 RCCL cluster (halo0 head + halo1 worker) lives in the sibling
# file: ../multi-node/inventory/hosts
#
# halo0 runs ONE model at a time. It is both a Vulkan and a ROCm host, so it is
# listed in both capability groups below; the model you launch is chosen by
# which track playbook you run (one at a time), not by group membership.
#
# Run the single-node bootstrap with this file:
#   ansible-playbook -i ansible/single-node/inventory/hosts ansible/single-node/bootstrap.yml
#
# Password-fed become (native, no NOPASSWD):
#   ansible_become_exe=/usr/bin/sudo.ws -> classic C sudo (writes -p prompt plain).
#   Default sudo-rs on Ubuntu 26.04 wraps -p as '[sudo: ...] Password:'
#   which ansible's become prompt-match never detects (times out).
# =============================================================================

# Capability groups — hosts are grouped by GPU BACKEND so playbooks target a
# backend (vulkan / rocm) instead of one model. `aiservers` is the union of all
# inference hosts and is what the shared host-level plays target.

# Vulkan backend — Podman Vulkan (llama.cpp) tracks:
#   qwen36-35b-ud-q8-k-xl-mtp,
#   qwen38-27b-q38rocm (prebuilt image, MTP speed profile),
#   gemma-4-26b-a4b-ud-q8-k-xl
[vulkan]
#halo0 ansible_host=10.0.1.74 ansible_connection=ssh ansible_user=jdella
halo1 ansible_host=10.0.1.67 ansible_connection=ssh ansible_user=jdella

# ROCm backend — Podman ROCm tracks:
#   qwen38-flash-next-halogen (halogen-flash-server, prebuilt image)
#   ornith15-ciru-halo-agent-vllm (Ciru vLLM/ROCm + DFlash2, image built here)
# (Same box as vulkan for a single-machine setup; use a dedicated host if you
# run ROCm on a separate machine.)
[rocm]
#halo0 ansible_host=10.0.1.74 ansible_connection=ssh ansible_user=jdella
halo1 ansible_host=10.0.1.67 ansible_connection=ssh ansible_user=jdella

[aiservers:children]
vulkan
rocm
