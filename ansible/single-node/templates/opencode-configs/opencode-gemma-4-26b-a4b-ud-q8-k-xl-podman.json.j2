{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gemma-4-26b-a4b-ud-q8-k-xl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemma 4 26B A4B (UD-Q8_K_XL, vision)",
      "options": {
        "baseURL": "http://{{ ansible_host | default(inventory_hostname) }}:{{ port }}/v1",
        "apiKey": "gemma-4-26b-a4b-local"
      },
      "models": {
        "gemma-4-26b-a4b-it-ud-q8-k-xl": {
          "name": "Gemma 4 26B A4B (UD-Q8_K_XL, ~27.6 GB)",
          "modalities": {
            "input": ["text", "image"]
          },
          "limit": {
            "context": {{ ctx }},
            "output": 65536
          },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 }
        }
      }
    }
  }
}
