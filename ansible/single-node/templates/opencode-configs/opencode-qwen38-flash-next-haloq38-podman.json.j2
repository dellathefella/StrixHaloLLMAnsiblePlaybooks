{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "qwen38-flash-next-haloq38": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen3.8-Flash-Next IQ4_XS-PLE (haloq38flash, Strix Halo)",
      "options": {
        "baseURL": "http://{{ ansible_host | default(inventory_hostname) }}:{{ port }}/v1",
        "apiKey": "qwen38-flash-haloq38-local"
      },
      "models": {
        "qwen3.8-flash-next-haloq38": {
          "name": "Qwen3.8-Flash-Next IQ4_XS-PLE (~91 GB)",
          "limit": {
            "context": {{ ctx }},
            "output": 65536
          },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 }
        }
      }
    }
  }
}
