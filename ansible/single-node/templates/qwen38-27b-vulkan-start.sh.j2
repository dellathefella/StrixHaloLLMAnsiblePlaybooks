#!/bin/bash
# =============================================================================
# qwen38-27b-vulkan-start.sh — Qwen3.8-27B (llama.cpp Podman Vulkan container)
#
# Generated by the qwen38-27b-ud-q8-k-xl-podman bootstrap playbook.
#
# Container: ghcr.io/ggml-org/llama.cpp:server-vulkan-b10644
# Port: {{ port }}
# Model: {{ _models_dir }}/{{ model }}
#
# KyaniteLabs Strix Halo profile:
#   spec: draft-mtp + ngram-mod, n-max 12, n-min 24
#   KV cache: q4_0 (K+V)
# =============================================================================
set -euo pipefail

# --- config ---
QWEN38_27B_VULKAN_CONTAINER="${QWEN38_27B_VULKAN_CONTAINER:-{{ docker_container_name }}}"
QWEN38_27B_VULKAN_PORT="${QWEN38_27B_VULKAN_PORT:-{{ port }}}"
QWEN38_27B_VULKAN_MODEL="${QWEN38_27B_VULKAN_MODEL:-{{ _models_dir }}/{{ model }}}"
QWEN38_27B_VULKAN_IMAGE="${QWEN38_27B_VULKAN_IMAGE:-{{ docker_image }}}"
QWEN38_27B_VULKAN_CTX="${QWEN38_27B_VULKAN_CTX:-{{ _docker_ctx_len }}}"
QWEN38_27B_VULKAN_BATCH="${QWEN38_27B_VULKAN_BATCH:-{{ batch | d(256) }}}"
QWEN38_27B_VULKAN_GPU_LAYERS="${QWEN38_27B_VULKAN_GPU_LAYERS:-{{ n_gpu | d(999) }}}"
QWEN38_27B_VULKAN_CACHE_K="${QWEN38_27B_VULKAN_CACHE_K:-{{ cache_type_k }}}"
QWEN38_27B_VULKAN_CACHE_V="${QWEN38_27B_VULKAN_CACHE_V:-{{ cache_type_v }}}"
QWEN38_27B_VULKAN_SPEC_TYPE="${QWEN38_27B_VULKAN_SPEC_TYPE:-{{ spec_type }}}"
QWEN38_27B_VULKAN_SPEC_N_MAX="${QWEN38_27B_VULKAN_SPEC_N_MAX:-{{ spec_draft_n_max }}}"
QWEN38_27B_VULKAN_SPEC_N_MIN="${QWEN38_27B_VULKAN_SPEC_N_MIN:-{{ spec_ngram_mod_n_min }}}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp Vulkan container: $QWEN38_27B_VULKAN_CONTAINER"
  podman run -d --name "$QWEN38_27B_VULKAN_CONTAINER" \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    -v "${QWEN38_27B_VULKAN_MODEL}":"${QWEN38_27B_VULKAN_MODEL}":ro \
    -p "$QWEN38_27B_VULKAN_PORT":"$QWEN38_27B_VULKAN_PORT" \
    "$QWEN38_27B_VULKAN_IMAGE" \
    --model "$QWEN38_27B_VULKAN_MODEL" \
    --host 0.0.0.0 \
    --port "$QWEN38_27B_VULKAN_PORT" \
    --ctx-size "$QWEN38_27B_VULKAN_CTX" \
    --n-gpu-layers "$QWEN38_27B_VULKAN_GPU_LAYERS" \
    --batch-size "$QWEN38_27B_VULKAN_BATCH" \
    --cache-type-k "$QWEN38_27B_VULKAN_CACHE_K" \
    --cache-type-v "$QWEN38_27B_VULKAN_CACHE_V" \
    --spec-type "$QWEN38_27B_VULKAN_SPEC_TYPE" \
    --spec-draft-n-max "$QWEN38_27B_VULKAN_SPEC_N_MAX" \
    --spec-ngram-mod-n-min "$QWEN38_27B_VULKAN_SPEC_N_MIN"
}

stop_container() {
  podman stop "$QWEN38_27B_VULKAN_CONTAINER" 2>/dev/null || true
  podman rm -f "$QWEN38_27B_VULKAN_CONTAINER" 2>/dev/null || true
}

# --- check model exists ---
if [ ! -f "$QWEN38_27B_VULKAN_MODEL" ]; then
  echo "ERROR: model not found: $QWEN38_27B_VULKAN_MODEL" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{{"{.Names}"}}')
if echo "$CONTAINER_LIST" | grep -q "^${QWEN38_27B_VULKAN_CONTAINER}$"; then
  echo "Container '$QWEN38_27B_VULKAN_CONTAINER' exists — stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 60); do
  if curl -sf "http://localhost:$QWEN38_27B_VULKAN_PORT/health" >/dev/null 2>&1; then
    echo "=== llama.cpp Vulkan is ready ==="
    echo "Container: $QWEN38_27B_VULKAN_CONTAINER"
    echo "Image:     $QWEN38_27B_VULKAN_IMAGE"
    echo "Port:      $QWEN38_27B_VULKAN_PORT"
    echo "Model:     $QWEN38_27B_VULKAN_MODEL"
    echo "API:       http://localhost:$QWEN38_27B_VULKAN_PORT"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 2 minutes" >&2
exit 1