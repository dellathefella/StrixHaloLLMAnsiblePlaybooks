{%- set backend = script_backend | default(llm_backend) -%}
{%- set other_backend = 'rocm' if backend == 'vulkan' else 'vulkan' -%}
{%- set image = image_repo ~ ':' ~ backend ~ '-' ~ image_tag -%}
{%- set container = track_stem ~ '-' ~ backend -%}
{%- set pfx = (track_stem ~ '-' ~ backend) | upper | replace('-', '_') -%}
{%- macro ref(name) -%}{{ '$' }}{{ '{' }}{{ pfx }}_{{ name }}{{ '}' }}{%- endmacro -%}
{%- macro dflt(name, value) -%}{{ pfx }}_{{ name }}="{{ '$' }}{{ '{' }}{{ pfx }}_{{ name }}:-{{ value }}{{ '}' }}"{%- endmacro -%}
{%- set defaults = {
      'CONTAINER': container,
      'PORT': port,
      'MODEL': _models_dir ~ '/' ~ model,
      'DRAFT': _models_dir ~ '/' ~ mtp_draft_file,
      'IMAGE': image,
      'CTX': _docker_ctx_len,
      'PARALLEL': parallel | d(1),
      'BATCH': batch | d(2048),
      'UBATCH': ubatch | d(512),
      'GPU_LAYERS': n_gpu | d(999),
      'CACHE_K': cache_type_k,
      'CACHE_V': cache_type_v,
      'FLASH_ATTN': flash_attn | d('on'),
      'LOAD_MODE': load_mode | d('mmap'),
      'SPEC_TYPE': spec_type,
      'SPEC_DRAFT_N_MAX': spec_draft_n_max | d(3),
    } -%}
#!/bin/bash
# =============================================================================
# {{ track_stem }}-{{ backend }}-start.sh — Qwen3.8-27B (UD-Q4_K_XL)
#
# Generated by {{ track_stem }}-podman.yml for the {{ backend }} backend. The
# sibling {{ track_stem }}-{{ other_backend }}-start.sh starts the same model on
# the other backend (its own container name + image tag, same port).
#
# Image:     {{ image }}
# Container: {{ container }}
# Port:      {{ port }}
# Model:     {{ _models_dir }}/{{ model }}
# Drafter:   {{ _models_dir }}/{{ mtp_draft_file }}
#
# Speculation profile: MTP drafter ({{ spec_type }}, n-max {{ spec_draft_n_max | d(3) }})
#   KV cache: {{ cache_type_k }} K / {{ cache_type_v }} V
#   batch {{ batch | d(2048) }} / ubatch {{ ubatch | d(512) }}, flash-attn {{ flash_attn | d('on') }},
#   load mode {{ load_mode | d('mmap') }}, {{ parallel | d(1) }} server slot.
#
# Every setting is env-overridable behind the {{ pfx }}_ prefix, e.g.
#   {{ pfx }}_SPEC_DRAFT_N_MAX=4 ./{{ track_stem }}-{{ backend }}-start.sh
# =============================================================================
set -euo pipefail

# --- config ---
{%- for name, value in defaults.items() %}
{{ dflt(name, value) }}
{%- endfor %}

# The drafter lives under the model's directory (MTP/ subdir), so the container
# mounts that directory rather than only the single model file.
MODEL_DIR=$(dirname {{ ref('MODEL') }})

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp {{ backend }} container: {{ ref('CONTAINER') }}"
  podman run -d --name {{ ref('CONTAINER') }} \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint llama-server \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p {{ ref('PORT') }}:{{ ref('PORT') }} \
    {{ ref('IMAGE') }} \
    --model {{ ref('MODEL') }} \
    --model-draft {{ ref('DRAFT') }} \
    --host 0.0.0.0 \
    --port {{ ref('PORT') }} \
    --ctx-size {{ ref('CTX') }} \
    --parallel {{ ref('PARALLEL') }} \
    --n-gpu-layers {{ ref('GPU_LAYERS') }} \
    --batch-size {{ ref('BATCH') }} \
    --ubatch-size {{ ref('UBATCH') }} \
    --cache-type-k {{ ref('CACHE_K') }} \
    --cache-type-v {{ ref('CACHE_V') }} \
    --flash-attn {{ ref('FLASH_ATTN') }} \
    --load-mode {{ ref('LOAD_MODE') }} \
    --spec-type {{ ref('SPEC_TYPE') }} \
    --spec-draft-n-max {{ ref('SPEC_DRAFT_N_MAX') }}
}

stop_container() {
  podman stop {{ ref('CONTAINER') }} 2>/dev/null || true
  podman rm -f {{ ref('CONTAINER') }} 2>/dev/null || true
}

# --- check model + drafter exist ---
if [ ! -f {{ ref('MODEL') }} ]; then
  echo "ERROR: model not found: {{ ref('MODEL') }}" >&2
  exit 1
fi
if [ ! -f {{ ref('DRAFT') }} ]; then
  echo "ERROR: MTP drafter not found: {{ ref('DRAFT') }}" >&2
  echo "       hf download {{ hf_repo }} {{ mtp_draft_file }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{{ "{.Names}" }}')
if echo "$CONTAINER_LIST" | grep -q "^{{ ref('CONTAINER') }}$"; then
  echo "Container {{ ref('CONTAINER') }} exists — stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 60); do
  if curl -sf "http://localhost:{{ ref('PORT') }}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp {{ backend }} is ready ==="
    echo "Container: {{ ref('CONTAINER') }}"
    echo "Image:     {{ ref('IMAGE') }}"
    echo "Port:      {{ ref('PORT') }}"
    echo "Model:     {{ ref('MODEL') }}"
    echo "Drafter:   {{ ref('DRAFT') }}"
    echo "API:       http://localhost:{{ ref('PORT') }}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 2 minutes" >&2
echo "         check: podman logs {{ ref('CONTAINER') }}" >&2
exit 1
