#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-27B (UD-Q4_K_XL)
#
# Generated by {{ track_stem }}-podman.yml using Nathanw1014's
# Strix Halo tuned llama.cpp image (Vulkan, gfx1151 FA + MoE-prefill fixes).
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ port }}
# Model:     {{ _models_dir }}/{{ model }}
# Drafter:   {{ _models_dir }}/{{ mtp_draft_file }}
#
# Speculation profile: MTP drafter ({{ spec_type }}, n-max {{ spec_draft_n_max | d(3) }})
#   KV cache: {{ cache_type_k }} K / {{ cache_type_v }} V
#   batch {{ batch | d(2048) }} / ubatch {{ ubatch | d(512) }}, flash-attn {{ flash_attn | d('on') }},
#   load mode {{ load_mode | d('mmap') }}, {{ parallel | d(1) }} server slot.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ port }}"
MODEL="{{ _models_dir }}/{{ model }}"
DRAFT="{{ _models_dir }}/{{ mtp_draft_file }}"
IMAGE="{{ docker_image }}"
CTX="{{ _docker_ctx_len }}"
PARALLEL="{{ parallel | d(1) }}"
BATCH="{{ batch | d(2048) }}"
UBATCH="{{ ubatch | d(512) }}"
GPU_LAYERS="{{ n_gpu | d(999) }}"
CACHE_K="{{ cache_type_k }}"
CACHE_V="{{ cache_type_v }}"
FLASH_ATTN="{{ flash_attn | d('on') }}"
LOAD_MODE="{{ load_mode | d('mmap') }}"
SPEC_TYPE="{{ spec_type }}"
SPEC_DRAFT_N_MAX="{{ spec_draft_n_max | d(3) }}"

# The drafter lives under the model's directory (MTP/ subdir), so the container
# mounts that directory rather than only the single model file.
MODEL_DIR=$(dirname "$MODEL")

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp container: $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint llama-server \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p ${PORT}:${PORT} \
    $IMAGE \
    --model ${MODEL} \
    --model-draft ${DRAFT} \
    --host 0.0.0.0 \
    --port ${PORT} \
    --ctx-size ${CTX} \
    --parallel ${PARALLEL} \
    --n-gpu-layers ${GPU_LAYERS} \
    --batch-size ${BATCH} \
    --ubatch-size ${UBATCH} \
    --cache-type-k ${CACHE_K} \
    --cache-type-v ${CACHE_V} \
    --flash-attn ${FLASH_ATTN} \
    --load-mode ${LOAD_MODE} \
    --spec-type ${SPEC_TYPE} \
    --spec-draft-n-max ${SPEC_DRAFT_N_MAX}
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check model + drafter exist ---
if [ ! -f "$MODEL" ]; then
  echo "ERROR: model not found: $MODEL" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi
if [ ! -f "$DRAFT" ]; then
  echo "ERROR: MTP drafter not found: $DRAFT" >&2
  echo "       hf download {{ hf_repo }} {{ mtp_draft_file }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 60); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "Drafter:   $DRAFT"
    echo "API:       http://localhost:${PORT}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 2 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
exit 1
