#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-Flash-Next-AP 125B-A6B (Q5_K_XL, ~112 GiB)
#
# Generated by {{ track_stem }}-podman.yml using Nathanw1014's
# Strix Halo tuned llama.cpp image (Vulkan, gfx1151 FA + MoE-prefill fixes).
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ port }}
# Model:     {{ _model_path }}
# Projector: {{ _mmproj_path }} — required for image input
#
# Profile:   ctx {{ _docker_ctx_len }}, -ngl {{ n_gpu | d(99) }},
#            --n-cpu-moe {{ n_cpu_moe | d(0) }}, flash-attn {{ flash_attn | d('on') }},
#            --load-mode {{ load_mode | d('mmap') }}, --no-op-offload,
#            --override-tensor {{ override_tensor | d('per_layer_token_embd=CPU') }},
#            --jinja, --parallel {{ parallel | d(1) }},
#            defaults temp {{ temp }} / top-p {{ top_p }} / top-k {{ top_k }} / min-p {{ min_p }}.
#
# Image recognition: send images as "image_url" content parts to
#   /v1/chat/completions (OpenAI-compatible). The projector is offloaded to the
#   GPU by default; add --no-mmproj-offload to keep it on the CPU.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ port }}"
MODEL="{{ _model_path }}"
MMPROJ="{{ _mmproj_path }}"
IMAGE="{{ docker_image }}"
CTX="{{ _docker_ctx_len }}"
PARALLEL="{{ parallel | d(1) }}"
GPU_LAYERS="{{ n_gpu | d(99) }}"
N_CPU_MOE="{{ n_cpu_moe | d(0) }}"
FLASH_ATTN="{{ flash_attn | d('on') }}"
LOAD_MODE="{{ load_mode | d('mmap') }}"
OVERRIDE_TENSOR="{{ override_tensor | d('per_layer_token_embd=CPU') }}"
TEMP="{{ temp }}"
TOP_P="{{ top_p }}"
TOP_K="{{ top_k }}"
MIN_P="{{ min_p }}"

# Both weights and projector live under ~/models, bind-mounted read-only.
MODEL_DIR="{{ _models_dir }}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp container (vision enabled): $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint llama-server \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p ${PORT}:${PORT} \
    $IMAGE \
    --model ${MODEL} \
    --mmproj ${MMPROJ} \
    --host 0.0.0.0 \
    --port ${PORT} \
    --ctx-size ${CTX} \
    --n-gpu-layers ${GPU_LAYERS} \
    --n-cpu-moe ${N_CPU_MOE} \
    --flash-attn ${FLASH_ATTN} \
    --load-mode ${LOAD_MODE} \
    --no-op-offload \
    --override-tensor "${OVERRIDE_TENSOR}" \
    --temp ${TEMP} \
    --top-p ${TOP_P} \
    --top-k ${TOP_K} \
    --min-p ${MIN_P} \
    --jinja \
    --parallel ${PARALLEL}
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check model exists ---
if [ ! -f "$MODEL" ]; then
  echo "ERROR: model not found: $MODEL" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model_file }} --local-dir {{ _model_local_dir }}" >&2
  exit 1
fi

# --- check vision projector exists (image input needs it) ---
if [ ! -f "$MMPROJ" ]; then
  echo "ERROR: vision projector not found: $MMPROJ" >&2
  echo "       image recognition stays disabled — re-run the track or fetch it with:" >&2
  echo "       hf download {{ mmproj_repo }} {{ mmproj_file }} --local-dir {{ _mmproj_local_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health (a ~112 GiB mmap load is not instant) ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 180); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready (image input enabled) ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "Projector: $MMPROJ"
    echo "API:       http://localhost:${PORT}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 6 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
exit 1
