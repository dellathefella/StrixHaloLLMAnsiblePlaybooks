#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-27B (ROCmFP4-FAST) via LaurentZuijdwijk's
# llama.cpp fork (DFlash2 adaptive speculative decoding)
#
# Generated by {{ track_stem }}-podman.yml. Image is BUILT FROM SOURCE on
# first playbook run (pinned commit {{ llama_cpp_commit }}) — this script
# does not build it; re-run the playbook if the image is missing.
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ port }}
# Model:     {{ _models_dir }}/{{ model }}
# Drafter:   {{ _models_dir }}/{{ mtp_draft_file }} (DFlash2, UNVERIFIED flag
#            name --model-draft — see the playbook header comment)
#
# Profile:   ctx {{ _docker_ctx_len }}, -ngl {{ n_gpu | d(999) }} (main) /
#            {{ spec_draft_ngl | d(99) }} (draft), batch {{ batch | d(2048) }} /
#            ubatch {{ ubatch | d(512) }}, flash-attn {{ flash_attn | d('on') }},
#            {{ spec_type }} adaptive n {{ spec_draft_n_min | d(3) }}-{{ spec_draft_n_max | d(7) }}.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ port }}"
MODEL="{{ _models_dir }}/{{ model }}"
DRAFT="{{ _models_dir }}/{{ mtp_draft_file }}"
IMAGE="{{ docker_image }}"
CTX="{{ _docker_ctx_len }}"
GPU_LAYERS="{{ n_gpu | d(999) }}"
SPEC_DRAFT_NGL="{{ spec_draft_ngl | d(99) }}"
BATCH="{{ batch | d(2048) }}"
UBATCH="{{ ubatch | d(512) }}"
FLASH_ATTN="{{ flash_attn | d('on') }}"
SPEC_TYPE="{{ spec_type }}"
SPEC_DRAFT_N_MIN="{{ spec_draft_n_min | d(3) }}"
SPEC_DRAFT_N_MAX="{{ spec_draft_n_max | d(7) }}"

MODEL_DIR="{{ _models_dir }}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp container (LaurentZuijdwijk fork, DFlash2): $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint /app/llama-server \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p ${PORT}:${PORT} \
    $IMAGE \
    --model ${MODEL} \
    --model-draft ${DRAFT} \
    --host 0.0.0.0 \
    --port ${PORT} \
    --ctx-size ${CTX} \
    --n-gpu-layers ${GPU_LAYERS} \
    --spec-draft-ngl ${SPEC_DRAFT_NGL} \
    --batch-size ${BATCH} \
    --ubatch-size ${UBATCH} \
    --flash-attn ${FLASH_ATTN} \
    --spec-type ${SPEC_TYPE} \
    --spec-draft-adaptive \
    --spec-draft-n-min ${SPEC_DRAFT_N_MIN} \
    --spec-draft-n-max ${SPEC_DRAFT_N_MAX}
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check image was built ---
if ! podman image exists "$IMAGE"; then
  echo "ERROR: image not found: $IMAGE" >&2
  echo "       re-run the {{ track_stem }}-podman playbook to build it (compiles" >&2
  echo "       llama.cpp + Vulkan shaders on the target — can take several minutes)." >&2
  exit 1
fi

# --- check model + drafter exist ---
if [ ! -f "$MODEL" ]; then
  echo "ERROR: model not found: $MODEL" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi
if [ ! -f "$DRAFT" ]; then
  echo "ERROR: DFlash2 drafter not found: $DRAFT" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ mtp_repo }} {{ mtp_draft_file }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 60); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready (DFlash2) ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "Drafter:   $DRAFT"
    echo "API:       http://localhost:${PORT}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 2 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
echo "         if it started but ignored the drafter, --model-draft may be" >&2
echo "         the wrong flag for --spec-type draft-dflash on this fork:" >&2
echo "         podman run -it --rm --entrypoint /app/llama-server $IMAGE --help" >&2
exit 1
