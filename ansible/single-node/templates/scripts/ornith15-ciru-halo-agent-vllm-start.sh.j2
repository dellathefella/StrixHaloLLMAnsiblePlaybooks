#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Ornith1.5 Ciru Halo Agent (35B-A3B IU4 +
# DFlash2) via Ciru's custom vLLM/ROCm runtime, containerized in Podman.
#
# Generated by {{ track_stem }}-podman.yml. The image is BUILT from the
# bundled Ciru runtime installer (see the Containerfile); this script only
# runs it — rebuild via the playbook if the tag is missing.
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ host_port }} (OpenAI-compatible /v1 + /health, model: {{ model_id }})
# Bundle:    {{ _base_dir }}/bundle -> /bundle (RW — server cache lives there)
# Runtime:   {{ _image_runtime_root }} inside the image (ORNITH_RUNTIME_ROOT)
# Launcher:  {{ _serve_script }} (vision {{ 'ON' if vision_enabled else 'OFF' }})
#
# Profile:   ctx {{ ctx }} | 8 active sequences | 44 GiB shared KV/state pool
#            | prefix caching ON | adaptive DFlash2 (15/7/off under 32K).
# ~100 GB memory budget loaded — stop the other tracks first.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ host_port }}"
IMAGE="{{ docker_image }}"
BASE_DIR="{{ _base_dir }}"
BUNDLE_DIR="{{ _base_dir }}/bundle"
RUNTIME_ROOT="{{ _image_runtime_root }}"
SERVE_SCRIPT="{{ _serve_script }}"

# --- helper functions ---
start_container() {
  echo "Starting Ciru Halo Agent container: $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm --pull=never \
    --device=/dev/kfd \
    --device=/dev/dri \
    --group-add keep-groups \
    --ipc=host \
    --ulimit memlock=-1:-1 \
    -v "${BUNDLE_DIR}:/bundle" \
    -e ORNITH_RUNTIME_ROOT="${RUNTIME_ROOT}" \
    -p ${PORT}:${PORT} \
    $IMAGE \
    $SERVE_SCRIPT --host 0.0.0.0 --port $PORT
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check image exists (built by the playbook; rebuild hint if missing) ---
if ! podman image exists "$IMAGE"; then
  echo "ERROR: image not found: $IMAGE" >&2
  echo "       The Ciru runtime image is BUILT by the playbook — re-run:" >&2
  echo "       ansible-playbook -i ansible/single-node/inventory/hosts ansible/single-node/{{ track_stem }}-podman.yml" >&2
  exit 1
fi

# --- check bundle exists ---
if [ ! -f "${BUNDLE_DIR}/models/target/protected-00.safetensors" ]; then
  echo "ERROR: Ciru bundle not found under ${BUNDLE_DIR}" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} --local-dir ${BASE_DIR}" >&2
  exit 1
fi
if [ ! -f "${BUNDLE_DIR}${SERVE_SCRIPT}" ]; then
  echo "ERROR: serve script not found: ${BUNDLE_DIR}${SERVE_SCRIPT}" >&2
  echo "       (vision_enabled mismatch? re-download the bundle)" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for Ciru Halo Agent health check (first startup compiles GPU kernels — this is slow)..."
for i in $(seq 1 240); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== Ciru Halo Agent is ready ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Bundle:    $BUNDLE_DIR -> /bundle (RW)"
    echo "Launcher:  $SERVE_SCRIPT (vision {{ 'ON' if vision_enabled else 'OFF' }})"
    echo "API:       http://localhost:${PORT}/v1  (model: {{ model_id }})"
    echo "Smoke test: curl -s http://localhost:${PORT}/v1/models"
    exit 0
  fi
  sleep 5
done

echo "WARNING: Ciru Halo Agent did not become healthy within 20 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
echo "         (first startup compiles/loads GPU kernels and builds" >&2
echo "         bundle/cache; if the log shows progress, wait and re-check" >&2
echo "         /health)" >&2
exit 1
