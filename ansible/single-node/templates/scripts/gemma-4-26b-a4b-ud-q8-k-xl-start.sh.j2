#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Gemma 4 26B A4B it (UD-Q8_K_XL, ~27.6 GB)
#
# Generated by {{ track_stem }}-podman.yml using Nathanw1014's
# Strix Halo tuned llama.cpp image (Vulkan, gfx1151 FA + MoE-prefill fixes).
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ port }}
# Model:     {{ _models_dir }}/{{ model }}
# Projector: {{ _models_dir }}/{{ mmproj_local }} — required for image input
#
# Image recognition: send images as "image_url" content parts to
#   /v1/chat/completions (OpenAI-compatible). The projector is offloaded to
#   the GPU by default; add --no-mmproj-offload to keep it on the CPU.
#
# Profile:   ctx {{ _docker_ctx_len }}, -ngl {{ n_gpu | d(999) }},
#            batch {{ batch | d(256) }}.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ port }}"
MODEL="{{ _models_dir }}/{{ model }}"
MMPROJ="{{ _models_dir }}/{{ mmproj_local }}"
IMAGE="{{ docker_image }}"
CTX="{{ _docker_ctx_len }}"
BATCH="{{ batch | d(256) }}"
GPU_LAYERS="{{ n_gpu | d(999) }}"

# Both weights and projector live in ~/models, bind-mounted read-only.
MODEL_DIR="{{ _models_dir }}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp container (vision enabled): $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint llama-server \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p ${PORT}:${PORT} \
    $IMAGE \
    --model ${MODEL} \
    --mmproj ${MMPROJ} \
    --host 0.0.0.0 \
    --port ${PORT} \
    --ctx-size ${CTX} \
    --n-gpu-layers ${GPU_LAYERS} \
    --batch-size ${BATCH}
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check model exists ---
if [ ! -f "$MODEL" ]; then
  echo "ERROR: model not found: $MODEL" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- check vision projector exists (image input needs it) ---
if [ ! -f "$MMPROJ" ]; then
  echo "ERROR: vision projector not found: $MMPROJ" >&2
  echo "       image recognition stays disabled — re-run the track or fetch it with:" >&2
  echo "       hf download {{ hf_repo }} {{ mmproj_file }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 90); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready (image input enabled) ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "Projector: $MMPROJ"
    echo "API:       http://localhost:${PORT}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 3 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
exit 1
