{%- set backend = script_backend | default(llm_backend) -%}
{%- set other_backend = 'rocm' if backend == 'vulkan' else 'vulkan' -%}
{%- set image = image_repo ~ ':' ~ backend ~ '-' ~ image_tag -%}
{%- set container = track_stem ~ '-' ~ backend -%}
{%- set pfx = (track_stem ~ '-' ~ backend) | upper | replace('-', '_') -%}
{%- macro ref(name) -%}{{ '$' }}{{ '{' }}{{ pfx }}_{{ name }}{{ '}' }}{%- endmacro -%}
{%- macro dflt(name, value) -%}{{ pfx }}_{{ name }}="{{ '$' }}{{ '{' }}{{ pfx }}_{{ name }}:-{{ value }}{{ '}' }}"{%- endmacro -%}
{%- set defaults = {
      'CONTAINER': container,
      'PORT': port,
      'MODEL': _models_dir ~ '/' ~ model,
      'MMPROJ': _models_dir ~ '/' ~ mmproj_local,
      'IMAGE': image,
      'CTX': _docker_ctx_len,
      'BATCH': batch | d(256),
      'GPU_LAYERS': n_gpu | d(999),
    } -%}
#!/bin/bash
# =============================================================================
# {{ track_stem }}-{{ backend }}-start.sh — Gemma 4 26B A4B it (UD-Q8_K_XL, ~27.6 GB)
#
# Generated by {{ track_stem }}-podman.yml for the {{ backend }} backend. The
# sibling {{ track_stem }}-{{ other_backend }}-start.sh starts the same model on
# the other backend (its own container name + image tag, same port).
#
# Image:     {{ image }}
# Container: {{ container }}
# Port:      {{ port }}
# Model:     {{ _models_dir }}/{{ model }}
# Projector: {{ _models_dir }}/{{ mmproj_local }} — required for image input
#
# Image recognition: send images as "image_url" content parts to
#   /v1/chat/completions (OpenAI-compatible). The projector is offloaded to
#   the GPU by default; add --no-mmproj-offload to keep it on the CPU.
#
# Every setting is env-overridable behind the {{ pfx }}_ prefix, e.g.
#   {{ pfx }}_CTX=131072 ./{{ track_stem }}-{{ backend }}-start.sh
# =============================================================================
set -euo pipefail

# --- config ---
{%- for name, value in defaults.items() %}
{{ dflt(name, value) }}
{%- endfor %}

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp {{ backend }} container (vision enabled): {{ ref('CONTAINER') }}"
  podman run -d --name {{ ref('CONTAINER') }} \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint llama-server \
    "${MOUNT_ARGS[@]}" \
    -p {{ ref('PORT') }}:{{ ref('PORT') }} \
    {{ ref('IMAGE') }} \
    --model {{ ref('MODEL') }} \
    --mmproj {{ ref('MMPROJ') }} \
    --host 0.0.0.0 \
    --port {{ ref('PORT') }} \
    --ctx-size {{ ref('CTX') }} \
    --n-gpu-layers {{ ref('GPU_LAYERS') }} \
    --batch-size {{ ref('BATCH') }}
}

stop_container() {
  podman stop {{ ref('CONTAINER') }} 2>/dev/null || true
  podman rm -f {{ ref('CONTAINER') }} 2>/dev/null || true
}

# --- check model exists ---
if [ ! -f {{ ref('MODEL') }} ]; then
  echo "ERROR: model not found: {{ ref('MODEL') }}" >&2
  exit 1
fi

# --- check vision projector exists (image input needs it) ---
if [ ! -f {{ ref('MMPROJ') }} ]; then
  echo "ERROR: vision projector not found: {{ ref('MMPROJ') }}" >&2
  echo "       image recognition stays disabled — re-run the track or fetch it with:" >&2
  echo "       hf download {{ hf_repo }} {{ mmproj_file }} --local-dir $(dirname {{ ref('MMPROJ') }})" >&2
  exit 1
fi

# Both weights and projector must be visible inside the container. They live in
# the same ~/models directory, which is bind-mounted read-only at the same path;
# a second mount is only added if someone points the projector somewhere else.
_MODEL_DIR=$(dirname {{ ref('MODEL') }})
_MMPROJ_DIR=$(dirname {{ ref('MMPROJ') }})
MOUNT_ARGS=(-v "${_MODEL_DIR}:${_MODEL_DIR}:ro")
if [ "${_MMPROJ_DIR}" != "${_MODEL_DIR}" ]; then
  MOUNT_ARGS+=(-v "${_MMPROJ_DIR}:${_MMPROJ_DIR}:ro")
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{{ "{.Names}" }}')
if echo "$CONTAINER_LIST" | grep -q "^{{ ref('CONTAINER') }}$"; then
  echo "Container {{ ref('CONTAINER') }} exists — stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 90); do
  if curl -sf "http://localhost:{{ ref('PORT') }}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp {{ backend }} is ready (image input enabled) ==="
    echo "Container: {{ ref('CONTAINER') }}"
    echo "Image:     {{ ref('IMAGE') }}"
    echo "Port:      {{ ref('PORT') }}"
    echo "Model:     {{ ref('MODEL') }}"
    echo "Projector: {{ ref('MMPROJ') }}"
    echo "API:       http://localhost:{{ ref('PORT') }}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 3 minutes" >&2
echo "         check: podman logs {{ ref('CONTAINER') }}" >&2
exit 1
