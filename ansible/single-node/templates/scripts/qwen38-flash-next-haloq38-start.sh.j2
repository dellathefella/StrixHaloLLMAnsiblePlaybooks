#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-Flash-Next (IQ4_XS-PLE) via
# julianmb's haloq38flash build (Nathanw1014/llama.cpp, strix-halo-vulkan)
#
# Generated by {{ track_stem }}-podman.yml. Image is BUILT FROM SOURCE on
# first playbook run — this script does not build it; re-run the playbook
# if the image is missing.
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ port }}
# Model:     {{ _models_dir }}/{{ model }}
# MTP:       {{ _models_dir }}/{{ mtp_draft_file }} (optional per upstream,
#            wired in here via --model-draft / --spec-type draft-mtp)
#
# Profile:   ctx {{ _docker_ctx_len }}, -ngl {{ n_gpu | d(999) }}, ubatch
#            {{ ubatch | d(2048) }}, threads {{ threads | d(4) }}, flash-attn
#            {{ flash_attn | d('on') }}, KV cache {{ cache_type_k }}/{{ cache_type_v }}
#            (see the playbook header — the old unsloth-quant track crashed
#            on quantized KV for this architecture; drop to f16 if this does).
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ port }}"
MODEL="{{ _models_dir }}/{{ model }}"
DRAFT="{{ _models_dir }}/{{ mtp_draft_file }}"
IMAGE="{{ docker_image }}"
CTX="{{ _docker_ctx_len }}"
GPU_LAYERS="{{ n_gpu | d(999) }}"
UBATCH="{{ ubatch | d(2048) }}"
THREADS="{{ threads | d(4) }}"
FLASH_ATTN="{{ flash_attn | d('on') }}"
CACHE_TYPE_K="{{ cache_type_k }}"
CACHE_TYPE_V="{{ cache_type_v }}"
SPEC_TYPE="{{ spec_type }}"
SPEC_DRAFT_N_MAX="{{ spec_draft_n_max | d(3) }}"

MODEL_DIR="{{ _models_dir }}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp container (haloq38flash): $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint /app/llama-server \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p ${PORT}:${PORT} \
    $IMAGE \
    --model ${MODEL} \
    --model-draft ${DRAFT} \
    --host 0.0.0.0 \
    --port ${PORT} \
    --ctx-size ${CTX} \
    --n-gpu-layers ${GPU_LAYERS} \
    --flash-attn ${FLASH_ATTN} \
    --cache-type-k ${CACHE_TYPE_K} \
    --cache-type-v ${CACHE_TYPE_V} \
    --ubatch-size ${UBATCH} \
    --threads ${THREADS} \
    --jinja \
    --spec-type ${SPEC_TYPE} \
    --spec-draft-n-max ${SPEC_DRAFT_N_MAX}
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check image was built ---
if ! podman image exists "$IMAGE"; then
  echo "ERROR: image not found: $IMAGE" >&2
  echo "       re-run the {{ track_stem }}-podman playbook to build it (compiles" >&2
  echo "       llama.cpp + Vulkan shaders on the target — can take several minutes)." >&2
  exit 1
fi

# --- check model + MTP sidecar exist ---
if [ ! -f "$MODEL" ]; then
  echo "ERROR: model not found: $MODEL" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi
if [ ! -f "$DRAFT" ]; then
  echo "ERROR: MTP sidecar not found: $DRAFT" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ mtp_draft_file }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 60); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "Drafter:   $DRAFT"
    echo "API:       http://localhost:${PORT}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 2 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
echo "         if it died on KV cache allocation, try f16 instead of" >&2
echo "         ${CACHE_TYPE_K}/${CACHE_TYPE_V} — see the playbook header comment." >&2
exit 1
