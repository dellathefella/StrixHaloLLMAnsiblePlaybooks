#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-27B (ROCmFP4-FAST) via julianmb's
# q38rocm image (profile-driven run_server.sh: MTP + TurboQuant KV + caching)
#
# Generated by {{ track_stem }}-podman.yml. Image is PULLED (never built).
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ host_port }}
# Model:     {{ _models_dir }}/{{ model }}  (mounted read-only at {{ _container_models_dir }})
# Profile:   {{ profile }} (ctx 131072, MTP on, KV q8_0/turbo4, prompt cache)
# Draft:     MTP draft_n={{ draft_n }} (measured best on halo1)
#
# STABILITY: long-context Vulkan prefill needs a 126 GiB TTM limit
# (ttm.pages_limit=33030144) or it trips "Fence fallback timer expired"
# -> vk::DeviceLostError. Set via the shared set-grub/limine-ttm playbooks.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ host_port }}"
MODEL="{{ _models_dir }}/{{ model }}"
CONTAINER_MODEL="{{ _container_models_dir }}/{{ model }}"
MODEL_DIR="{{ _models_dir }}"
CONTAINER_MODELS="{{ _container_models_dir }}"
IMAGE="{{ docker_image }}"
PROFILE="{{ profile }}"
DRAFT_N="{{ draft_n }}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp container (q38rocm, $PROFILE profile): $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm \
    --device=/dev/kfd \
    --device=/dev/dri \
    --group-add keep-groups \
    --security-opt seccomp=unconfined \
    --ulimit memlock=-1:-1 \
    -v "${MODEL_DIR}:${CONTAINER_MODELS}:ro" \
    -e PROFILE=${PROFILE} \
    -e DRAFT_N=${DRAFT_N} \
    -e HOST=0.0.0.0 \
    -e PORT=${PORT} \
    -p ${PORT}:${PORT} \
    $IMAGE \
    ${CONTAINER_MODEL}
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check image is present (pull if missing) ---
if ! podman image exists "$IMAGE"; then
  echo "Image not found locally, pulling: $IMAGE"
  podman pull "$IMAGE"
fi

# --- check model exists ---
if [ ! -f "$MODEL" ]; then
  echo "ERROR: model not found: $MODEL" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check (13.5 GB cold load)..."
for i in $(seq 1 90); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready (q38rocm $PROFILE) ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "Profile:   $PROFILE (MTP draft_n=$DRAFT_N)"
    echo "API:       http://localhost:${PORT}/v1"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 3 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
echo "         and TTM: cat /sys/module/ttm/parameters/pages_limit (want 33030144)" >&2
exit 1
