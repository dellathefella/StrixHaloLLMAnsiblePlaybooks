#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-27B (ROCmFP4_FAST) on the ROCmFPX engine
#
# Generated by {{ track_stem }}-podman.yml using julianmb's PUBLIC
# ghcr.io/julianmb/q38rocm image (custom ROCmFPX llama.cpp fork, gfx1151).
#
# Unlike the vanilla tracks, this image's run_server.sh entrypoint builds the
# whole server command itself (speed profile: ctx 128K, MTP speculation,
# KV K=q8_0/V=turbo4, 128K prompt cache). We only:
#   - mount the single model file at /app/models (read-only)
#   - map the host port to the image's fixed internal port 8000
#   - pass the model path + ctx + slots
# MTP is BUILT INTO the model (no separate --model-draft drafter).
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ port }} (host) -> {{ container_internal_port }} (container)
# Model:     {{ _models_dir }}/{{ model }}  ->  {{ _models_mount }}/{{ model }}
#
# Runtime tuning (speed profile defaults; override via the playbook vars or by
# appending run_server.sh flags to the command below):
#   CTX={{ _docker_ctx_len }}, SLOTS={{ parallel }} — KV K=q8_0/V=turbo4,
#   batch 2048 / ubatch 1024, MTP draft-n 4, prompt cache 32 GiB / 64 ckpts.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
HOST_PORT="{{ port }}"
CONTAINER_PORT="{{ container_internal_port }}"
IMAGE="{{ docker_image }}"
CTX="{{ _docker_ctx_len }}"
SLOTS="{{ parallel | d(1) }}"

# Model file lives in the host models dir; the image expects it under /app/models.
MODEL_HOST="{{ _models_dir }}/{{ model }}"
MODEL_DIR_HOST="$(dirname "${MODEL_HOST}")"
MODEL_CONTAINER="{{ _models_mount }}/{{ model }}"

# --- helper functions ---
start_container() {
  echo "Starting ROCmFPX container: $CONTAINER"
  podman run -d --name "$CONTAINER" \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    -v "${MODEL_DIR_HOST}:{{ _models_mount }}:ro" \
    -p ${HOST_PORT}:${CONTAINER_PORT} \
    "$IMAGE" \
    "$MODEL_CONTAINER" \
    --ctx "$CTX" \
    --slots "$SLOTS"
}

stop_container() {
  podman stop "$CONTAINER" 2>/dev/null || true
  podman rm -f "$CONTAINER" 2>/dev/null || true
}

# --- check model exists ---
if [ ! -f "$MODEL_HOST" ]; then
  echo "ERROR: model not found: $MODEL_HOST" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health (the image's entrypoint needs time to load ~13.5 GB) ---
echo "Waiting for llama-server health check (up to 3 min)..."
for i in $(seq 1 90); do
  if curl -sf "http://localhost:${HOST_PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp (ROCmFPX) is ready ==="
    echo "Container:     $CONTAINER"
    echo "Image:         $IMAGE"
    echo "Port:          ${HOST_PORT} (host) -> ${CONTAINER_PORT} (container)"
    echo "Model:         $MODEL_HOST"
    echo "API:           http://localhost:${HOST_PORT}/v1"
    echo "Logs:          podman logs -f $CONTAINER"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 3 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
exit 1