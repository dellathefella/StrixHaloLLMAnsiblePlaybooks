{%- set backend = script_backend | default(llm_backend) -%}
{%- set other_backend = 'rocm' if backend == 'vulkan' else 'vulkan' -%}
{%- set image = image_repo ~ ':server-' ~ backend ~ '-' ~ image_tag -%}
{%- set container = track_stem ~ '-' ~ backend -%}
{%- set pfx = (track_stem ~ '-' ~ backend) | upper | replace('-', '_') -%}
{%- macro ref(name) -%}{{ '$' }}{{ '{' }}{{ pfx }}_{{ name }}{{ '}' }}{%- endmacro -%}
{%- macro dflt(name, value) -%}{{ pfx }}_{{ name }}="{{ '$' }}{{ '{' }}{{ pfx }}_{{ name }}:-{{ value }}{{ '}' }}"{%- endmacro -%}
{%- set defaults = {
      'CONTAINER': container,
      'PORT': port,
      'MODEL': _models_dir ~ '/' ~ model,
      'IMAGE': image,
      'CTX': _docker_ctx_len,
      'BATCH': batch | d(256),
      'GPU_LAYERS': n_gpu | d(999),
    } -%}
#!/bin/bash
# =============================================================================
# {{ track_stem }}-{{ backend }}-start.sh — Qwen3.6-35B-A3B (UD-Q8_K_XL, ~38.5 GB)
#
# Generated by {{ track_stem }}-podman.yml for the {{ backend }} backend. The
# sibling {{ track_stem }}-{{ other_backend }}-start.sh starts the same model on
# the other backend (its own container name + image tag, same port).
#
# Image:     {{ image }}
# Container: {{ container }}
# Port:      {{ port }}
# Model:     {{ _models_dir }}/{{ model }}
#
# Every setting is env-overridable behind the {{ pfx }}_ prefix, e.g.
#   {{ pfx }}_CTX=131072 ./{{ track_stem }}-{{ backend }}-start.sh
# =============================================================================
set -euo pipefail

# --- config ---
{%- for name, value in defaults.items() %}
{{ dflt(name, value) }}
{%- endfor %}

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp {{ backend }} container: {{ ref('CONTAINER') }}"
  podman run -d --name {{ ref('CONTAINER') }} \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    -v {{ ref('MODEL') }}:{{ ref('MODEL') }}:ro \
    -p {{ ref('PORT') }}:{{ ref('PORT') }} \
    {{ ref('IMAGE') }} \
    --model {{ ref('MODEL') }} \
    --host 0.0.0.0 \
    --port {{ ref('PORT') }} \
    --ctx-size {{ ref('CTX') }} \
    --n-gpu-layers {{ ref('GPU_LAYERS') }} \
    --batch-size {{ ref('BATCH') }}
}

stop_container() {
  podman stop {{ ref('CONTAINER') }} 2>/dev/null || true
  podman rm -f {{ ref('CONTAINER') }} 2>/dev/null || true
}

# --- check model exists ---
if [ ! -f {{ ref('MODEL') }} ]; then
  echo "ERROR: model not found: {{ ref('MODEL') }}" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{{ "{.Names}" }}')
if echo "$CONTAINER_LIST" | grep -q "^{{ ref('CONTAINER') }}$"; then
  echo "Container {{ ref('CONTAINER') }} exists — stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 60); do
  if curl -sf "http://localhost:{{ ref('PORT') }}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp {{ backend }} is ready ==="
    echo "Container: {{ ref('CONTAINER') }}"
    echo "Image:     {{ ref('IMAGE') }}"
    echo "Port:      {{ ref('PORT') }}"
    echo "Model:     {{ ref('MODEL') }}"
    echo "API:       http://localhost:{{ ref('PORT') }}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 2 minutes" >&2
echo "         check: podman logs {{ ref('CONTAINER') }}" >&2
exit 1
