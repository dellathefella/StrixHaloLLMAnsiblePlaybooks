#!/bin/bash
# =============================================================================
# gemma-4-26b-a4b-vulkan-start.sh — Gemma 4 26B A4B it (llama.cpp Podman Vulkan container, vision)
#
# Generated by the gemma-4-26b-a4b-ud-q8-k-xl-podman bootstrap playbook.
#
# Container: ghcr.io/ggml-org/llama.cpp:server-vulkan-b10666
# Port: {{ port }}
# Model: {{ _models_dir }}/{{ model }}
# Vision projector: {{ _models_dir }}/{{ mmproj_local }} — required for image input
#
# Image recognition: send images as "image_url" content parts to
#   /v1/chat/completions (OpenAI-compatible). The projector is offloaded to
#   the GPU by default; add --no-mmproj-offload to keep it on the CPU.
# =============================================================================
set -euo pipefail

# --- config ---
GEMMA4_26B_VULKAN_CONTAINER="${GEMMA4_26B_VULKAN_CONTAINER:-{{ docker_container_name }}}"
GEMMA4_26B_VULKAN_PORT="${GEMMA4_26B_VULKAN_PORT:-{{ port }}}"
GEMMA4_26B_VULKAN_MODEL="${GEMMA4_26B_VULKAN_MODEL:-{{ _models_dir }}/{{ model }}}"
GEMMA4_26B_VULKAN_MMPROJ="${GEMMA4_26B_VULKAN_MMPROJ:-{{ _models_dir }}/{{ mmproj_local }}}"
GEMMA4_26B_VULKAN_IMAGE="${GEMMA4_26B_VULKAN_IMAGE:-{{ docker_image }}}"
GEMMA4_26B_VULKAN_CTX="${GEMMA4_26B_VULKAN_CTX:-{{ _docker_ctx_len }}}"
GEMMA4_26B_VULKAN_BATCH="${GEMMA4_26B_VULKAN_BATCH:-{{ batch | d(256) }}}"
GEMMA4_26B_VULKAN_GPU_LAYERS="${GEMMA4_26B_VULKAN_GPU_LAYERS:-{{ n_gpu | d(999) }}}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp Vulkan container (vision enabled): $GEMMA4_26B_VULKAN_CONTAINER"
  podman run -d --name "$GEMMA4_26B_VULKAN_CONTAINER" \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    "${MOUNT_ARGS[@]}" \
    -p "$GEMMA4_26B_VULKAN_PORT":"$GEMMA4_26B_VULKAN_PORT" \
    "$GEMMA4_26B_VULKAN_IMAGE" \
    --model "$GEMMA4_26B_VULKAN_MODEL" \
    --mmproj "$GEMMA4_26B_VULKAN_MMPROJ" \
    --host 0.0.0.0 \
    --port "$GEMMA4_26B_VULKAN_PORT" \
    --ctx-size "$GEMMA4_26B_VULKAN_CTX" \
    --n-gpu-layers "$GEMMA4_26B_VULKAN_GPU_LAYERS" \
    --batch-size "$GEMMA4_26B_VULKAN_BATCH"
}

stop_container() {
  podman stop "$GEMMA4_26B_VULKAN_CONTAINER" 2>/dev/null || true
  podman rm -f "$GEMMA4_26B_VULKAN_CONTAINER" 2>/dev/null || true
}

# --- check model exists ---
if [ ! -f "$GEMMA4_26B_VULKAN_MODEL" ]; then
  echo "ERROR: model not found: $GEMMA4_26B_VULKAN_MODEL" >&2
  exit 1
fi

# --- check vision projector exists (image input needs it) ---
if [ ! -f "$GEMMA4_26B_VULKAN_MMPROJ" ]; then
  echo "ERROR: vision projector not found: $GEMMA4_26B_VULKAN_MMPROJ" >&2
  echo "       image recognition stays disabled — re-run the track or fetch it with:" >&2
  echo "       hf download {{ hf_repo }} {{ mmproj_file }} --local-dir $(dirname "$GEMMA4_26B_VULKAN_MMPROJ")" >&2
  exit 1
fi

# Both weights and projector must be visible inside the container. They live in
# the same ~/models directory, which is bind-mounted read-only at the same path;
# a second mount is only added if someone points the projector somewhere else.
_MODEL_DIR="$(dirname "$GEMMA4_26B_VULKAN_MODEL")"
_MMPROJ_DIR="$(dirname "$GEMMA4_26B_VULKAN_MMPROJ")"
MOUNT_ARGS=(-v "${_MODEL_DIR}:${_MODEL_DIR}:ro")
if [ "$_MMPROJ_DIR" != "$_MODEL_DIR" ]; then
  MOUNT_ARGS+=(-v "${_MMPROJ_DIR}:${_MMPROJ_DIR}:ro")
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{{"{.Names}"}}')
if echo "$CONTAINER_LIST" | grep -q "^${GEMMA4_26B_VULKAN_CONTAINER}$"; then
  echo "Container '$GEMMA4_26B_VULKAN_CONTAINER' exists — stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 90); do
  if curl -sf "http://localhost:$GEMMA4_26B_VULKAN_PORT/health" >/dev/null 2>&1; then
    echo "=== llama.cpp Vulkan is ready (image input enabled) ==="
    echo "Container: $GEMMA4_26B_VULKAN_CONTAINER"
    echo "Image:     $GEMMA4_26B_VULKAN_IMAGE"
    echo "Port:      $GEMMA4_26B_VULKAN_PORT"
    echo "Model:     $GEMMA4_26B_VULKAN_MODEL"
    echo "Projector: $GEMMA4_26B_VULKAN_MMPROJ"
    echo "API:       http://localhost:$GEMMA4_26B_VULKAN_PORT"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 3 minutes" >&2
exit 1
