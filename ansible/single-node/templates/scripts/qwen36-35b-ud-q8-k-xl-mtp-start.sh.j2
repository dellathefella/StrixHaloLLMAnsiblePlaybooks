#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.6-35B-A3B MTP (UD-Q8_K_XL, ~38.5 GB)
#
# Generated by {{ track_stem }}-podman.yml using Nathanw1014's
# Strix Halo tuned llama.cpp image (Vulkan, gfx1151 FA + MoE-prefill fixes).
# MTP is baked into this GGUF (unsloth/Qwen3.6-35B-A3B-MTP-GGUF) — no
# separate drafter file/--model-draft, just --spec-type draft-mtp.
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ port }}
# Model:     {{ _models_dir }}/{{ model }}
#
# Profile:   ctx {{ _docker_ctx_len }}, -ngl {{ n_gpu | d(99) }},
#            batch {{ batch | d(256) }}, flash-attn {{ flash_attn | d('on') }},
#            --parallel {{ parallel | d(1) }} (MTP requires -np 1),
#            {{ spec_type }} n-max {{ spec_draft_n_max | d(2) }}.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ port }}"
MODEL="{{ _models_dir }}/{{ model }}"
IMAGE="{{ docker_image }}"
CTX="{{ _docker_ctx_len }}"
PARALLEL="{{ parallel | d(1) }}"
BATCH="{{ batch | d(256) }}"
GPU_LAYERS="{{ n_gpu | d(99) }}"
FLASH_ATTN="{{ flash_attn | d('on') }}"
SPEC_TYPE="{{ spec_type }}"
SPEC_DRAFT_N_MAX="{{ spec_draft_n_max | d(2) }}"

# Mount the models directory
MODEL_DIR="{{ _models_dir }}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp container (MTP): $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint llama-server \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p ${PORT}:${PORT} \
    $IMAGE \
    --model ${MODEL} \
    --host 0.0.0.0 \
    --port ${PORT} \
    --ctx-size ${CTX} \
    --parallel ${PARALLEL} \
    --n-gpu-layers ${GPU_LAYERS} \
    --batch-size ${BATCH} \
    --flash-attn ${FLASH_ATTN} \
    --spec-type ${SPEC_TYPE} \
    --spec-draft-n-max ${SPEC_DRAFT_N_MAX}
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check model exists ---
if [ ! -f "$MODEL" ]; then
  echo "ERROR: model not found: $MODEL" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 60); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready (MTP) ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "API:       http://localhost:${PORT}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 2 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
echo "         if it exited on load, confirm the image's llama.cpp build" >&2
echo "         supports --spec-type draft-mtp for this architecture." >&2
exit 1
