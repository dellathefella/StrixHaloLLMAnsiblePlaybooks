#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-Flash-Next (W4B, ~118 GB) via
# peonist's halogen-flash-server (closed-source ROCm engine, prebuilt image)
#
# Generated by {{ track_stem }}-podman.yml. The image is PULLED, not built;
# this script re-pulls only if the registry has a newer {{ image_tag }}.
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ host_port }} (OpenAI-compatible /v1 + /health)
# Weights:   {{ _models_dir }}/{{ _checkpoint_file }}
#            {{ _models_dir }}/{{ _overlay_file }} (quality overlay, auto-loaded)
#            {{ _models_dir }}/{{ _vision_file }} (vision tower, image input ON)
#            {{ _models_dir }}/tokenizer/
#
# Profile:   ctx {{ _docker_ctx_len }} (HALOGEN_CTX default), greedy sampling
#            by default. To match the model card's thinking-mode settings,
#            uncomment the HALOGEN_* env block in start_container below.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ host_port }}"
CHECKPOINT="{{ _models_dir }}/{{ _checkpoint_file }}"
OVERLAY="{{ _models_dir }}/{{ _overlay_file }}"
VISION="{{ _models_dir }}/{{ _vision_file }}"
IMAGE="{{ docker_image }}"
# CTX is informational only — the halogen engine auto-discovers its context
# (HALOGEN_CTX default 262144); it is NOT passed to `podman run` here.
CTX="{{ _docker_ctx_len }}"

MODEL_DIR="{{ _models_dir }}"

# --- helper functions ---
start_container() {
  echo "Starting halogen-flash-server container: $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm --pull=newer \
    --device=/dev/kfd \
    --device=/dev/dri \
    --group-add keep-groups \
    --ipc=host \
    --ulimit memlock=-1:-1 \
    -v "${MODEL_DIR}:/models:ro" \
    -e HALOGEN_VISION_TOWER="/models/{{ _vision_file }}" \
    -p ${PORT}:${PORT} \
    $IMAGE
    # Sampling — greedy by default. Uncomment to match the model card's
    # thinking-mode settings (temp 1.0 / top_p 0.95 / top_k 20):
    # -e HALOGEN_TEMPERATURE=1.0
    # -e HALOGEN_TOP_P=0.95
    # -e HALOGEN_TOP_K=20
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check image exists (pulled by the playbook; pull it if missing) ---
if ! podman image exists "$IMAGE"; then
  echo "Image not found locally — pulling $IMAGE (prebuilt, no build step)..."
  podman pull "$IMAGE"
  if ! podman image exists "$IMAGE"; then
    echo "ERROR: pull failed. Re-run the {{ track_stem }}-podman playbook." >&2
    exit 1
  fi
fi

# --- check weights exist ---
if [ ! -f "$CHECKPOINT" ]; then
  echo "ERROR: checkpoint not found: $CHECKPOINT" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} --include {{ _checkpoint_file }} --include {{ _overlay_file }} --include {{ _vision_file }} --include 'tokenizer/*' --local-dir {{ _models_dir }}" >&2
  exit 1
fi
if [ ! -f "$OVERLAY" ]; then
  echo "ERROR: quality overlay not found: $OVERLAY (halogen runs without it," >&2
  echo "       but the card's quality settings assume it). Fetch it with:" >&2
  echo "       hf download {{ hf_repo }} --include {{ _overlay_file }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi
if [ ! -f "$VISION" ]; then
  echo "ERROR: vision tower not found: $VISION (image input needs it; halogen" >&2
  echo "       would start text-only even with HALOGEN_VISION_TOWER set)." >&2
  echo "       Fetch it with:" >&2
  echo "       hf download {{ hf_repo }} --include {{ _vision_file }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for halogen-flash-server health check (118 GiB cold load — this is slow)..."
for i in $(seq 1 240); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== halogen-flash-server is ready ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Checkpoint: $CHECKPOINT"
    echo "Overlay:   $OVERLAY"
    echo "Vision:    $VISION (image input enabled)"
    echo "API:       http://localhost:${PORT}/v1"
    echo "Smoke test: curl -s http://localhost:${PORT}/v1/models"
    exit 0
  fi
  sleep 5
done

echo "WARNING: halogen-flash-server did not become healthy within 20 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
echo "         (the first cold load of ~118 GiB into the GPU pool can take a" >&2
echo "         while; if it is still loading, wait and re-check /health)" >&2
exit 1
