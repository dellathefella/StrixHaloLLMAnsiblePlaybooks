{%- set backend = script_backend | default(llm_backend) -%}
{%- set other_backend = 'rocm' if backend == 'vulkan' else 'vulkan' -%}
{%- set image = image_repo ~ ':server-' ~ backend ~ '-' ~ image_tag -%}
{%- set container = track_stem ~ '-' ~ backend -%}
{%- set pfx = (track_stem ~ '-' ~ backend) | upper | replace('-', '_') -%}
{%- macro ref(name) -%}{{ '$' }}{{ '{' }}{{ pfx }}_{{ name }}{{ '}' }}{%- endmacro -%}
{%- macro dflt(name, value) -%}{{ pfx }}_{{ name }}="{{ '$' }}{{ '{' }}{{ pfx }}_{{ name }}:-{{ value }}{{ '}' }}"{%- endmacro -%}
{%- set defaults = {
      'CONTAINER': container,
      'PORT': port,
      'MODEL': _model_path,
      'IMAGE': image,
      'CTX': _docker_ctx_len,
      'PARALLEL': parallel | d(1),
      'BATCH': batch | d(2048),
      'UBATCH': ubatch | d(512),
      'GPU_LAYERS': n_gpu | d(999),
      'CACHE_K': cache_type_k,
      'CACHE_V': cache_type_v,
      'FLASH_ATTN': flash_attn | d('on'),
      'LOAD_MODE': load_mode | d('none'),
      'REASONING': reasoning | d('on'),
      'TEMP': temp,
      'TOP_P': top_p,
      'TOP_K': top_k,
      'MIN_P': min_p,
    } -%}
{%- set shards = [
      _model_dir_path ~ '/' ~ (model_shard_1 | basename),
      _model_dir_path ~ '/' ~ (model_shard_2 | basename),
      _model_dir_path ~ '/' ~ (model_shard_3 | basename),
    ] -%}
#!/bin/bash
# =============================================================================
# {{ track_stem }}-{{ backend }}-start.sh — Qwen3.8-Flash-Next 125B-A6B
# (UD-IQ4_XS, 3 shards, ~87 GiB on disk)
#
# Generated by {{ track_stem }}-podman.yml for the {{ backend }} backend. The
# sibling {{ track_stem }}-{{ other_backend }}-start.sh starts the same model on
# the other backend (its own container name + image tag, same port).
#
# Image:     {{ image }}
# Container: {{ container }}
# Port:      {{ port }}
# Model:     {{ _model_path }} (shard 1 of 3 — llama.cpp reads shards 2+3 from
#            the same directory, so that directory is what gets mounted)
#
# Profile (from the Strix Halo launch notes): ctx {{ _docker_ctx_len }},
# {{ parallel | d(1) }} slot, -ngl {{ n_gpu | d(999) }}, flash-attn {{ flash_attn | d('on') }},
# load mode {{ load_mode | d('none') }} (no mmap), KV cache {{ cache_type_k }}/{{ cache_type_v }}
# (quantized KV asserts on qwen4exp), --jinja, reasoning {{ reasoning | d('on') }},
# defaults temp {{ temp }} / top-p {{ top_p }} / top-k {{ top_k }} / min-p {{ min_p }}.
#
# Every setting is env-overridable behind the {{ pfx }}_ prefix, e.g.
#   {{ pfx }}_CTX=65536 ./{{ track_stem }}-{{ backend }}-start.sh
# =============================================================================
set -euo pipefail

# --- config ---
{%- for name, value in defaults.items() %}
{{ dflt(name, value) }}
{%- endfor %}

# The three shards, in the directory llama.cpp is pointed at.
{{ dflt('SHARDS', shards | join(' ')) }}

# Mount this rather than the model file itself — part 1 alone is not loadable.
MODEL_DIR=$(dirname {{ ref('MODEL') }})

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp {{ backend }} container: {{ ref('CONTAINER') }}"
  podman run -d --name {{ ref('CONTAINER') }} \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p {{ ref('PORT') }}:{{ ref('PORT') }} \
    {{ ref('IMAGE') }} \
    --model {{ ref('MODEL') }} \
    --host 0.0.0.0 \
    --port {{ ref('PORT') }} \
    --ctx-size {{ ref('CTX') }} \
    --parallel {{ ref('PARALLEL') }} \
    --n-gpu-layers {{ ref('GPU_LAYERS') }} \
    --batch-size {{ ref('BATCH') }} \
    --ubatch-size {{ ref('UBATCH') }} \
    --cache-type-k {{ ref('CACHE_K') }} \
    --cache-type-v {{ ref('CACHE_V') }} \
    --flash-attn {{ ref('FLASH_ATTN') }} \
    --load-mode {{ ref('LOAD_MODE') }} \
    --jinja \
    --reasoning {{ ref('REASONING') }} \
    --temp {{ ref('TEMP') }} \
    --top-p {{ ref('TOP_P') }} \
    --top-k {{ ref('TOP_K') }} \
    --min-p {{ ref('MIN_P') }}
}

stop_container() {
  podman stop {{ ref('CONTAINER') }} 2>/dev/null || true
  podman rm -f {{ ref('CONTAINER') }} 2>/dev/null || true
}

# --- check every shard is present (part 1 is not loadable without 2 and 3) ---
for shard in {{ ref('SHARDS') }}; do
  if [ ! -f "$shard" ]; then
    echo "ERROR: model shard not found: $shard" >&2
    echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
    echo "       hf download {{ hf_repo }} UD-IQ4_XS/<shard> --local-dir {{ _models_dir }}" >&2
    exit 1
  fi
done

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{{ "{.Names}" }}')
if echo "$CONTAINER_LIST" | grep -q "^{{ ref('CONTAINER') }}$"; then
  echo "Container {{ ref('CONTAINER') }} exists — stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health (an ~87 GiB load with --load-mode none is not instant) ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 180); do
  if curl -sf "http://localhost:{{ ref('PORT') }}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp {{ backend }} is ready ==="
    echo "Container: {{ ref('CONTAINER') }}"
    echo "Image:     {{ ref('IMAGE') }}"
    echo "Port:      {{ ref('PORT') }}"
    echo "Model:     {{ ref('MODEL') }}"
    echo "API:       http://localhost:{{ ref('PORT') }}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 6 minutes" >&2
echo "         check: podman logs {{ ref('CONTAINER') }}" >&2
exit 1
