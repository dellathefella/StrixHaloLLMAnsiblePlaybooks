#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-Flash-Next 125B-A6B (UD-IQ4_XS, 3 shards)
#
# Generated by {{ track_stem }}-podman.yml using Nathanw1014's
# Strix Halo tuned llama.cpp image (Vulkan, gfx1151 FA + MoE-prefill fixes).
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ port }}
# Model dir: {{ _model_dir_path }}
#
# Profile:   ctx {{ _docker_ctx_len }}, 1 slot, -ngl 999, flash-attn on,
#            load mode {{ load_mode | d('none') }} (no mmap), KV cache f16,
#            --jinja, reasoning {{ reasoning | d('on') }},
#            defaults temp {{ temp }} / top-p {{ top_p }} / top-k {{ top_k }} / min-p {{ min_p }}.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ port }}"
MODEL="{{ _model_path }}"
IMAGE="{{ docker_image }}"
CTX="{{ _docker_ctx_len }}"
PARALLEL="{{ parallel | d(1) }}"
BATCH="{{ batch | d(2048) }}"
UBATCH="{{ ubatch | d(512) }}"
GPU_LAYERS="{{ n_gpu | d(999) }}"
FLASH_ATTN="{{ flash_attn | d('on') }}"
LOAD_MODE="{{ load_mode | d('none') }}"
REASONING="{{ reasoning | d('on') }}"
TEMP="{{ temp }}"
TOP_P="{{ top_p }}"
TOP_K="{{ top_k }}"
MIN_P="{{ min_p }}"

# Mount the model directory (all 3 shards)
MODEL_DIR="{{ _model_dir_path }}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp container: $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint llama-server \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p ${PORT}:${PORT} \
    $IMAGE \
    --model ${MODEL} \
    --host 0.0.0.0 \
    --port ${PORT} \
    --ctx-size ${CTX} \
    --parallel ${PARALLEL} \
    --n-gpu-layers ${GPU_LAYERS} \
    --batch-size ${BATCH} \
    --ubatch-size ${UBATCH} \
    --flash-attn ${FLASH_ATTN} \
    --load-mode ${LOAD_MODE} \
    --jinja \
    --reasoning ${REASONING} \
    --temp ${TEMP} \
    --top-p ${TOP_P} \
    --top-k ${TOP_K} \
    --min-p ${MIN_P}
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check every shard is present (part 1 is not loadable without 2 and 3) ---
for shard in ${MODEL_DIR}/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf ${MODEL_DIR}/Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf ${MODEL_DIR}/Qwen3.8-Flash-Next-UD-IQ4_XS-00003-of-00003.gguf; do
  if [ ! -f "$shard" ]; then
    echo "ERROR: model shard not found: $shard" >&2
    echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
    echo "       hf download {{ hf_repo }} --include 'UD-IQ4_XS/*' --local-dir {{ _models_dir }}" >&2
    exit 1
  fi
done

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health (an ~87 GiB load with --load-mode none is not instant) ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 180); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "API:       http://localhost:${PORT}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 6 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
exit 1
