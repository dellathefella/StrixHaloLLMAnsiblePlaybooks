#!/bin/bash
# =============================================================================
# qwen38-flash-next-iq4-xs-vulkan-start.sh — Qwen3.8-Flash-Next 125B-A6B
# (llama.cpp Podman Vulkan container, UD-IQ4_XS quant)
#
# Generated by the qwen38-flash-next-ud-iq4-xs-podman bootstrap playbook.
#
# Container: {{ docker_image }}
# Port: {{ port }}
# Model: {{ _model_path }} (shard 1 of 3 — llama.cpp reads shards 2+3 from the
#          same directory, so that directory is what gets mounted)
#
# Profile (from the Strix Halo launch notes): ctx {{ _docker_ctx_len }},
# {{ parallel | d(1) }} slot, -ngl {{ n_gpu | d(999) }}, flash-attn {{ flash_attn | d('on') }},
# load mode {{ load_mode | d('none') }} (no mmap), KV cache {{ cache_type_k }}/{{ cache_type_v }}
# (quantized KV asserts on qwen4exp), --jinja, reasoning {{ reasoning | d('on') }},
# defaults temp {{ temp }} / top-p {{ top_p }} / top-k {{ top_k }} / min-p {{ min_p }}.
# =============================================================================
set -euo pipefail

# --- config ---
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER:-{{ docker_container_name }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PORT="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PORT:-{{ port }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL:-{{ _model_path }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_IMAGE="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_IMAGE:-{{ docker_image }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CTX="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CTX:-{{ _docker_ctx_len }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PARALLEL="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PARALLEL:-{{ parallel | d(1) }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_BATCH="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_BATCH:-{{ batch | d(2048) }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_UBATCH="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_UBATCH:-{{ ubatch | d(512) }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_GPU_LAYERS="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_GPU_LAYERS:-{{ n_gpu | d(999) }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CACHE_K="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CACHE_K:-{{ cache_type_k }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CACHE_V="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CACHE_V:-{{ cache_type_v }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_FLASH_ATTN="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_FLASH_ATTN:-{{ flash_attn | d('on') }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_LOAD_MODE="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_LOAD_MODE:-{{ load_mode | d('none') }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_REASONING="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_REASONING:-{{ reasoning | d('on') }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_TEMP="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_TEMP:-{{ temp }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_TOP_P="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_TOP_P:-{{ top_p }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_TOP_K="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_TOP_K:-{{ top_k }}}"
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MIN_P="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MIN_P:-{{ min_p }}}"

# The three shards, in the directory llama.cpp is pointed at.
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_SHARDS="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_SHARDS:-{{ _model_dir_path }}/{{ model_shard_1 | basename }} {{ _model_dir_path }}/{{ model_shard_2 | basename }} {{ _model_dir_path }}/{{ model_shard_3 | basename }}}"

# Mount this rather than the model file itself — part 1 alone is not loadable.
QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL_DIR="${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL%/*}"
if [ "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL_DIR" = "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL" ]; then
  QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL_DIR="{{ _model_dir_path }}"
fi

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp Vulkan container: $QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER"
  podman run -d --name "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER" \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    -v "${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL_DIR}":"${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL_DIR}":ro \
    -p "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PORT":"$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PORT" \
    "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_IMAGE" \
    --model "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL" \
    --host 0.0.0.0 \
    --port "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PORT" \
    --ctx-size "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CTX" \
    --parallel "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PARALLEL" \
    --n-gpu-layers "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_GPU_LAYERS" \
    --batch-size "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_BATCH" \
    --ubatch-size "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_UBATCH" \
    --cache-type-k "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CACHE_K" \
    --cache-type-v "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CACHE_V" \
    --flash-attn "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_FLASH_ATTN" \
    --load-mode "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_LOAD_MODE" \
    --jinja \
    --reasoning "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_REASONING" \
    --temp "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_TEMP" \
    --top-p "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_TOP_P" \
    --top-k "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_TOP_K" \
    --min-p "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MIN_P"
}

stop_container() {
  podman stop "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER" 2>/dev/null || true
  podman rm -f "$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER" 2>/dev/null || true
}

# --- check every shard is present (part 1 is not loadable without 2 and 3) ---
for shard in $QWEN38_FLASH_NEXT_IQ4XS_VULKAN_SHARDS; do
  if [ ! -f "$shard" ]; then
    echo "ERROR: model shard not found: $shard" >&2
    echo "       re-run the qwen38-flash-next-ud-iq4-xs-podman playbook, or:" >&2
    echo "       hf download unsloth/Qwen3.8-Flash-Next-GGUF UD-IQ4_XS/<shard> --local-dir ~/models" >&2
    exit 1
  fi
done

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{{"{.Names}"}}')
if echo "$CONTAINER_LIST" | grep -q "^${QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER}$"; then
  echo "Container '$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER' exists — stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health (an ~87 GiB load with --load-mode none is not instant) ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 180); do
  if curl -sf "http://localhost:$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PORT/health" >/dev/null 2>&1; then
    echo "=== llama.cpp Vulkan is ready ==="
    echo "Container: $QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER"
    echo "Image:     $QWEN38_FLASH_NEXT_IQ4XS_VULKAN_IMAGE"
    echo "Port:      $QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PORT"
    echo "Model:     $QWEN38_FLASH_NEXT_IQ4XS_VULKAN_MODEL"
    echo "API:       http://localhost:$QWEN38_FLASH_NEXT_IQ4XS_VULKAN_PORT"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 6 minutes" >&2
echo "         check: podman logs $QWEN38_FLASH_NEXT_IQ4XS_VULKAN_CONTAINER" >&2
exit 1

