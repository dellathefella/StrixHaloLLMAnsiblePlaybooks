#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-Flash-Next 125B-A6B (UD-Q2_K_XL, 3 shards)
#
# Generated by {{ track_stem }}-podman.yml using Nathanw1014's
# Strix Halo tuned llama.cpp image (Vulkan, gfx1151 FA + MoE-prefill fixes).
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ port }}
# Model:     {{ _model_path }} (shard 1 of 3 — llama.cpp reads shards 2+3 from
#            the same directory, so that directory is what gets mounted)
#
# qwen4exp keeps an f16 KV cache (quantized KV asserts on this arch), so no
# --cache-type-k/--cache-type-v is passed here.
#
# Profile:   ctx {{ _docker_ctx_len }}, -ngl {{ n_gpu | d(999) }},
#            batch {{ batch | d(256) }}.
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ port }}"
MODEL="{{ _model_path }}"
IMAGE="{{ docker_image }}"
CTX="{{ _docker_ctx_len }}"
BATCH="{{ batch | d(256) }}"
GPU_LAYERS="{{ n_gpu | d(999) }}"

# The three shards, in the directory llama.cpp is pointed at.
MODEL_DIR="{{ _model_dir_path }}"
SHARDS="{{ _model_dir_path }}/{{ model_shard_1 | basename }} {{ _model_dir_path }}/{{ model_shard_2 | basename }} {{ _model_dir_path }}/{{ model_shard_3 | basename }}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp container: $CONTAINER"
  podman run -d --name $CONTAINER \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    --entrypoint llama-server \
    -v "${MODEL_DIR}:${MODEL_DIR}:ro" \
    -p ${PORT}:${PORT} \
    $IMAGE \
    --model ${MODEL} \
    --host 0.0.0.0 \
    --port ${PORT} \
    --ctx-size ${CTX} \
    --n-gpu-layers ${GPU_LAYERS} \
    --batch-size ${BATCH}
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check every shard is present (part 1 is not loadable without 2 and 3) ---
for shard in ${SHARDS}; do
  if [ ! -f "$shard" ]; then
    echo "ERROR: model shard not found: $shard" >&2
    echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
    echo "       hf download {{ hf_repo }} --include 'UD-Q2_K_XL/*' --local-dir {{ _models_dir }}" >&2
    exit 1
  fi
done

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 90); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "API:       http://localhost:${PORT}"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 3 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
exit 1
