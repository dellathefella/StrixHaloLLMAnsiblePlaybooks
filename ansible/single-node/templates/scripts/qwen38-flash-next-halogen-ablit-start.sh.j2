#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-Flash-Next ABLITERATED (W4B) via
# peonist's halogen-flash-server, with the Ae55667 patch kit applied.
#
# Generated by {{ track_stem }}-podman.yml. The expert patch is applied by the
# PLAYBOOK (not this script) — this script only (re)starts the engine against
# the already-patched base + the abliterated overlay.
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ host_port }} (OpenAI-compatible /v1 + /health)
# Base:      {{ _base_dir }}/{{ _checkpoint_file }}  (vendor @ {{ vendor_rev[:12] }}, experts patched)
# Overlay:   {{ _ablit_dir }}/{{ _ablit_overlay_file }}  (HALOGEN_CK_OVERLAY)
# Tokenizer: {{ _base_dir }}/tokenizer/
#
# Roll back: python3 {{ _ablit_dir }}/restore_expert_patch.py {{ _base_dir }}/{{ _checkpoint_file }}
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ host_port }}"
BASE_DIR="{{ _base_dir }}"
ABLIT_DIR="{{ _ablit_dir }}"
CHECKPOINT="${BASE_DIR}/{{ _checkpoint_file }}"
OVERLAY="${ABLIT_DIR}/{{ _ablit_overlay_file }}"
MARKER="${BASE_DIR}/.ablit-patched"
IMAGE="{{ docker_image }}"
VISION_ENABLED="{{ '1' if enable_vision | bool else '0' }}"
# CTX is informational — the engine auto-discovers its context (HALOGEN_CTX).
CTX="{{ _docker_ctx_len }}"

# --- helper functions ---
start_container() {
  echo "Starting halogen-flash-server (ABLITERATED) container: $CONTAINER"
  # The engine needs large contiguous blocks for its KV pool — drop caches first.
  sudo sysctl -w vm.drop_caches=1 vm.compact_memory=1 >/dev/null 2>&1 || \
    echo "WARN: could not drop caches (needs sudo); may fail if memory fragmented" >&2
  local vision_arg=()
  if [ "$VISION_ENABLED" = "1" ]; then
    vision_arg=(-e HALOGEN_VISION_TOWER=1)
  fi
  podman run -d --name $CONTAINER \
    --rm --pull=newer \
    --device=/dev/kfd \
    --device=/dev/dri \
    --group-add keep-groups \
    --security-opt seccomp=unconfined \
    --security-opt label=disable \
    --ipc=host \
    --ulimit memlock=-1:-1 \
    -v "${BASE_DIR}:/models:ro" \
    -v "${ABLIT_DIR}:/ablit:ro" \
    -e HALOGEN_CK_OVERLAY="/ablit/{{ _ablit_overlay_file }}" \
    "${vision_arg[@]}" \
    -p ${PORT}:${PORT} \
    $IMAGE
}

stop_container() {
  podman stop $CONTAINER 2>/dev/null || true
  podman rm -f $CONTAINER 2>/dev/null || true
}

# --- check image exists (pull if missing) ---
if ! podman image exists "$IMAGE"; then
  echo "Image not found locally — pulling $IMAGE (prebuilt, no build step)..."
  podman pull "$IMAGE"
  if ! podman image exists "$IMAGE"; then
    echo "ERROR: pull failed. Re-run the {{ track_stem }}-podman playbook." >&2
    exit 1
  fi
fi

# --- check patched base + overlay exist ---
if [ ! -f "$CHECKPOINT" ]; then
  echo "ERROR: base checkpoint not found: $CHECKPOINT" >&2
  echo "       re-run the {{ track_stem }}-podman playbook (downloads vendor @ {{ vendor_rev[:12] }} + patches)." >&2
  exit 1
fi
if [ ! -f "$OVERLAY" ]; then
  echo "ERROR: abliterated overlay not found: $OVERLAY" >&2
  echo "       the patch kit must be downloaded by the playbook." >&2
  exit 1
fi
if [ ! -f "$MARKER" ]; then
  echo "WARNING: patch marker $MARKER not found — the base may be UNPATCHED." >&2
  echo "         Re-run the {{ track_stem }}-podman playbook to apply the expert patch" >&2
  echo "         (this script does NOT patch; it only starts the engine)." >&2
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for halogen-flash-server health check (~88 GiB resident, cold load is slow)..."
for i in $(seq 1 240); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== halogen-flash-server (ABLITERATED) is ready ==="
    echo "Container:  $CONTAINER"
    echo "Image:      $IMAGE"
    echo "Port:       $PORT"
    echo "Base:       $CHECKPOINT"
    echo "Overlay:    $OVERLAY (HALOGEN_CK_OVERLAY)"
    echo "Vision:     $([ "$VISION_ENABLED" = "1" ] && echo ON || echo OFF)"
    echo "API:        http://localhost:${PORT}/v1"
    echo "Smoke test: curl -s http://localhost:${PORT}/v1/chat/completions -H 'Content-Type: application/json' -d '{\"messages\":[{\"role\":\"user\",\"content\":\"Say hello.\"}],\"max_tokens\":64}'"
    exit 0
  fi
  sleep 5
done

echo "WARNING: halogen-flash-server did not become healthy within 20 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
echo "         if it sat at 'reserving the KV pool' then exited, memory was" >&2
echo "         fragmented — free it and retry." >&2
exit 1
