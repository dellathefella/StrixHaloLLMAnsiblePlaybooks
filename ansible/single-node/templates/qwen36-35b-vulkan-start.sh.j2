#!/bin/bash
# =============================================================================
# qwen36-35b-vulkan-start.sh — Qwen3.6-35B-A3B (llama.cpp Podman Vulkan container)
#
# Generated by the qwen36-35b-podman-rocm bootstrap playbook.
#
# Container: ghcr.io/ggml-org/llama.cpp:server-vulkan-b10644
# Port: {{ port }}
# Model: {{ _models_dir }}/{{ model }}
# =============================================================================
set -euo pipefail

# --- config ---
QWEN36_35B_VULKAN_CONTAINER="${QWEN36_35B_VULKAN_CONTAINER:-{{ docker_container_name }}}"
QWEN36_35B_VULKAN_PORT="${QWEN36_35B_VULKAN_PORT:-{{ port }}}"
QWEN36_35B_VULKAN_MODEL="${QWEN36_35B_VULKAN_MODEL:-{{ _models_dir }}/{{ model }}}"
QWEN36_35B_VULKAN_IMAGE="${QWEN36_35B_VULKAN_IMAGE:-{{ docker_image }}}"
QWEN36_35B_VULKAN_CTX="${QWEN36_35B_VULKAN_CTX:-{{ _docker_ctx_len }}}"
QWEN36_35B_VULKAN_BATCH="${QWEN36_35B_VULKAN_BATCH:-{{ batch | d(256) }}}"
QWEN36_35B_VULKAN_GPU_LAYERS="${QWEN36_35B_VULKAN_GPU_LAYERS:-{{ n_gpu | d(999) }}}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp Vulkan container: $QWEN36_35B_VULKAN_CONTAINER"
  podman run -d --name "$QWEN36_35B_VULKAN_CONTAINER" \
    --rm --pull=newer \
    --device=/dev/dri/renderD128 \
    --device=/dev/kfd \
    --privileged \
    -v "${QWEN36_35B_VULKAN_MODEL}":"${QWEN36_35B_VULKAN_MODEL}":ro \
    -p "$QWEN36_35B_VULKAN_PORT":"$QWEN36_35B_VULKAN_PORT" \
    "$QWEN36_35B_VULKAN_IMAGE" \
    --model "$QWEN36_35B_VULKAN_MODEL" \
    --host 0.0.0.0 \
    --port "$QWEN36_35B_VULKAN_PORT" \
    --ctx-size "$QWEN36_35B_VULKAN_CTX" \
    --n-gpu-layers "$QWEN36_35B_VULKAN_GPU_LAYERS" \
    --batch-size "$QWEN36_35B_VULKAN_BATCH"
}

stop_container() {
  podman stop "$QWEN36_35B_VULKAN_CONTAINER" 2>/dev/null || true
  podman rm -f "$QWEN36_35B_VULKAN_CONTAINER" 2>/dev/null || true
}

# --- check model exists ---
if [ ! -f "$QWEN36_35B_VULKAN_MODEL" ]; then
  echo "ERROR: model not found: $QWEN36_35B_VULKAN_MODEL" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{{"{.Names}"}}')
if echo "$CONTAINER_LIST" | grep -q "^${QWEN36_35B_VULKAN_CONTAINER}$"; then
  echo "Container '$QWEN36_35B_VULKAN_CONTAINER' exists — stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check..."
for i in $(seq 1 60); do
  if curl -sf "http://localhost:$QWEN36_35B_VULKAN_PORT/health" >/dev/null 2>&1; then
    echo "=== llama.cpp Vulkan is ready ==="
    echo "Container: $QWEN36_35B_VULKAN_CONTAINER"
    echo "Image:     $QWEN36_35B_VULKAN_IMAGE"
    echo "Port:      $QWEN36_35B_VULKAN_PORT"
    echo "Model:     $QWEN36_35B_VULKAN_MODEL"
    echo "API:       http://localhost:$QWEN36_35B_VULKAN_PORT"
    exit 0
  fi
  sleep 2
done

echo "WARNING: llama-server did not become healthy within 2 minutes" >&2
exit 1