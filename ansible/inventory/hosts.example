# Multi-machine inventory example for ansible/bootstrap.yml.
#
# Tracks:
#   ds4-c-iq2xxs                DeepSeek V4 Flash (ds4.c engine + IQ2XXS quant)
#   qwen36-35b-ud-q8-k-xl       Qwen3.6-35B-A3B (llama.cpp ROCm/HIP, ~/llama-cpp-qwen36)
#   qwen38-27b-ud-q8-k-xl       Qwen3.8-27B (llama.cpp ROCm/HIP, ~/llama-cpp-qwen38-27b)
#   qwen38-flash-next-ud-iq4-xs Qwen3.8-Flash-Next (llama.cpp Vulkan PR#27742, ~/llama-cpp-flash)
#   qwen35-397b-gptq-rccl       Qwen3.5-397B (vLLM + RCCL + GPTQ-Int4 quant)

# --- DS4-C-IQ2XXS (single-node + multi-node) ---
[ds4-c-iq2xxs_single]
node1 ansible_host=192.168.1.10 ansible_user=jdella

[ds4-c-iq2xxs_multi]
node2 ansible_host=192.168.1.11 ansible_user=jdella

[ds4-c-iq2xxs:children]
ds4-c-iq2xxs_single
ds4-c-iq2xxs_multi

# --- QWEN36-35B-UD-Q8-K-XL (llama.cpp ROCm/HIP, ~/llama-cpp-qwen36) ---
[qwen36-35b-ud-q8-k-xl]
node1 ansible_host=192.168.1.10 ansible_user=jdella

# --- QWEN38-27B-UD-Q4-K-XL (llama.cpp ROCm/HIP, ~/llama-cpp-qwen38-27b) ---
[qwen38-27b]
node1 ansible_host=192.168.1.10 ansible_user=jdella

# --- QWEN38-FLASH-NEXT-UD-IQ4-XS (llama.cpp Vulkan PR#27742, ~/llama-cpp-flash) ---
[qwen38-flash-next]
node1 ansible_host=192.168.1.10 ansible_user=jdella

# --- QWEN35-397B-GPTQ-RCCL (vLLM + RCCL cluster) ---
[qwen35-397b-gptq-rccl_head]
node1 ansible_host=192.168.1.10 ansible_user=jdella

[qwen35-397b-gptq-rccl_worker]
node2 ansible_host=192.168.1.11 ansible_user=jdella

[qwen35-397b-gptq-rccl:children]
qwen35-397b-gptq-rccl_head
qwen35-397b-gptq-rccl_worker
