#!/bin/bash
# =============================================================================
# qwen38-flash-next-ud-iq4-xs-start.sh — Qwen3.8-Flash-Next (UD-IQ4_XS, ~87 GB)
#
# Generated by the qwen38-flash-next-ud-iq4-xs bootstrap playbook ({{ ansible_date_time.iso8601 }}).
#
# Qwen3.8-Flash-Next: 125B total / 6B active + 51B n-gram table
# Hybrid attention: Gated DeltaNet + QSA sparse attention
# Quant: UD-IQ4_XS (3-part GGUF split, ~87 GB on disk)
# Build: llama.cpp PR #27742 (danielhanchen) — Vulkan/RADV (no ROCm kernels)
#
# Key settings:
#   --ctx-size {{ qwen38_flash_next_ud_iq4_xs_ctx }}   (131k — quantized KV asserts on this arch)
#   --n-gpu-layers {{ qwen38_flash_next_ud_iq4_xs_n_gpu }}  (all layers)
#   --cache-type-k f16                                   (f16 KV required — q4 crashes)
#   --cache-type-v f16
#   --flash-attn on
#   --load-mode none                                     (mmap-heavy, ~91 GB resident at ctx)
#   --reasoning on                                       # reasoning mode
#   --jinja                                              # Jinja chat template
#
# NOTE: PR #27742 adds no GPU kernels for this architecture.
#       Vulkan (RADV) used — Reddit user confirmed Vulkan wins on the
#       Qwen3.8 DeltaNet family. ~23 t/s from a 125B-class model on APU.
# =============================================================================
set -euo pipefail

# --- baked config (override via env) ---
QWEN38_FLASH_NEXT_UD_IQ4_XS_MODEL="${QWEN38_FLASH_NEXT_UD_IQ4_XS_MODEL:-{{ llama_common_models_dir }}/{{ qwen38_flash_next_ud_iq4_xs_model }}"
QWEN38_FLASH_NEXT_UD_IQ4_XS_BIN="${QWEN38_FLASH_NEXT_UD_IQ4_XS_BIN:-{{ qwen38_flash_next_ud_iq4_xs_engine_bin }}}"
QWEN38_FLASH_NEXT_UD_IQ4_XS_CTX="${QWEN38_FLASH_NEXT_UD_IQ4_XS_CTX:-{{ qwen38_flash_next_ud_iq4_xs_ctx }}}"
QWEN38_FLASH_NEXT_UD_IQ4_XS_PORT="${QWEN38_FLASH_NEXT_UD_IQ4_XS_PORT:-{{ qwen38_flash_next_ud_iq4_xs_port }}}"
QWEN38_FLASH_NEXT_UD_IQ4_XS_HOST="${QWEN38_FLASH_NEXT_UD_IQ4_XS_HOST:-{{ qwen38_flash_next_ud_iq4_xs_host }}}"
QWEN38_FLASH_NEXT_UD_IQ4_XS_DEVICE="${QWEN38_FLASH_NEXT_UD_IQ4_XS_DEVICE:-{{ qwen38_flash_next_ud_iq4_xs_device }}}"
QWEN38_FLASH_NEXT_UD_IQ4_XS_N_GPU="${QWEN38_FLASH_NEXT_UD_IQ4_XS_N_GPU:-{{ qwen38_flash_next_ud_iq4_xs_n_gpu }}}"

# --- llama.cpp shared libs ---
QWEN38_FLASH_NEXT_UD_IQ4_XS_LIB="${QWEN38_FLASH_NEXT_UD_IQ4_XS_LIB:-$(dirname "$QWEN38_FLASH_NEXT_UD_IQ4_XS_BIN")/../lib}"
[ -d "$QWEN38_FLASH_NEXT_UD_IQ4_XS_LIB" ] && export LD_LIBRARY_PATH="${QWEN38_FLASH_NEXT_UD_IQ4_XS_LIB}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# --- Vulkan runtime env ---
export VK_ICD_FILENAMES="/usr/share/vulkan/icd.d/radeon_icd.x86_64.json"

# --- sanity ---
[ -x "$QWEN38_FLASH_NEXT_UD_IQ4_XS_BIN" ] || { echo "llama-server not found: $QWEN38_FLASH_NEXT_UD_IQ4_XS_BIN (run bootstrap)" >&2; exit 1; }
[ -f "$QWEN38_FLASH_NEXT_UD_IQ4_XS_MODEL" ] || { echo "model part 1 not found: $QWEN38_FLASH_NEXT_UD_IQ4_XS_MODEL" >&2; exit 1; }

echo "Qwen3.8-Flash-Next UD-IQ4_XS (125B/6B) on $QWEN38_FLASH_NEXT_UD_IQ4_XS_DEVICE, ctx=$QWEN38_FLASH_NEXT_UD_IQ4_XS_CTX"
echo "3-part GGUF: $QWEN38_FLASH_NEXT_UD_IQ4_XS_MODEL + *-00002-of-* + *-00003-of-*"
echo "PR #27742 (Vulkan/RADV) — no ROCm kernels for this arch"
echo "Endpoint: http://$QWEN38_FLASH_NEXT_UD_IQ4_XS_HOST:$QWEN38_FLASH_NEXT_UD_IQ4_XS_PORT/v1   alias: qwen3.8-flash-next"

exec "$QWEN38_FLASH_NEXT_UD_IQ4_XS_BIN" \
  --model "$QWEN38_FLASH_NEXT_UD_IQ4_XS_MODEL" \
  --alias qwen3.8-flash-next-ud-iq4-xs \
  --device "$QWEN38_FLASH_NEXT_UD_IQ4_XS_DEVICE" \
  --n-gpu-layers "$QWEN38_FLASH_NEXT_UD_IQ4_XS_N_GPU" \
  --ctx-size "$QWEN38_FLASH_NEXT_UD_IQ4_XS_CTX" \
  --cache-type-k f16 \
  --cache-type-v f16 \
  --flash-attn on \
  --load-mode none \
  --reasoning on \
  --jinja \
  --host "$QWEN38_FLASH_NEXT_UD_IQ4_XS_HOST" --port "$QWEN38_FLASH_NEXT_UD_IQ4_XS_PORT" \
  "$@"
