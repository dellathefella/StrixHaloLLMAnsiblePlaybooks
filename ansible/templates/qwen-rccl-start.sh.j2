#!/bin/bash
# =============================================================================
# qwen-rccl-start.sh — Qwen3.5-397B RCCL cluster launch script
#
# Generated by the qwen-rccl bootstrap playbook ({{ ansible_date_time.iso8601 }}).
# One script for both nodes; choose the role via env:
#   QWEN_ROLE=head    -> Machine 1: Ray head + vLLM server
#   QWEN_ROLE=worker  -> Machine 2: joins the Ray head
#
# Requires the vllm_cluster container from the qwen-rccl bootstrap/setup.
# =============================================================================
set -euo pipefail

# --- role (env required) ---
QWEN_ROLE="${QWEN_ROLE:?set QWEN_ROLE=head|worker}"

# --- baked config (override via env) ---
QWEN_MODEL="${QWEN_MODEL:-{{ qwen_model }}}"
QWEN_PORT="${QWEN_PORT:-{{ qwen_port }}}"
QWEN_MAX_LEN="${QWEN_MAX_LEN:-{{ qwen_max_model_len }}}"
QWEN_TP="${QWEN_TP:-{{ qwen_tp_size }}}"
QWEN_GPU_UTIL="${QWEN_GPU_UTIL:-{{ qwen_gpu_util }}}"
QWEN_HEAD_IP="${QWEN_HEAD_IP:-{{ qwen_head_ip }}}"
QWEN_WORKER_IP="${QWEN_WORKER_IP:-{{ qwen_worker_ip }}}"

case "$QWEN_ROLE" in
  head)
    [ -n "$QWEN_HEAD_IP" ] || { echo "QWEN_HEAD_IP not set" >&2; exit 1; }
    echo "Starting Ray head on $QWEN_HEAD_IP ..."
    sudo podman exec vllm_cluster ray start --head --port=6379 \
      --node-ip-address="$QWEN_HEAD_IP" --num-gpus=1

    echo "Launching vLLM serve (detached)..."
    sudo podman exec -d vllm_cluster vllm serve "$QWEN_MODEL" \
      --port "$QWEN_PORT" --host 0.0.0.0 \
      --max-model-len "$QWEN_MAX_LEN" \
      --gpu-memory-utilization "$QWEN_GPU_UTIL" \
      --dtype float16 \
      --tensor-parallel-size "$QWEN_TP" \
      --distributed-executor-backend ray \
      --enforce-eager \
      --language-model-only \
      --reasoning-parser qwen3

    echo "CLUSTER READY — OpenAI endpoint: http://$QWEN_HEAD_IP:$QWEN_PORT/v1"
    echo "WARNING [context] max-model-len $QWEN_MAX_LEN is beyond the guide's tested 32768;"
    echo "   on a 2.5Gbps link KV sync scales with context — lower it if latency/OOM."
    ;;
  worker)
    [ -n "$QWEN_HEAD_IP" ] || { echo "QWEN_HEAD_IP not set" >&2; exit 1; }
    echo "Joining head $QWEN_HEAD_IP:6379 as worker $QWEN_WORKER_IP ..."
    sudo podman exec vllm_cluster ray start \
      --address="$QWEN_HEAD_IP:6379" \
      --node-ip-address="$QWEN_WORKER_IP" --num-gpus=1
    echo "Worker joined. Verify on the head: ray status (inside vllm_cluster)."
    echo "NOTE: worker uses the SAME context/model as the head; do not run vllm serve here."
    ;;
  *)
    echo "Unknown QWEN_ROLE '$QWEN_ROLE'" >&2; exit 1 ;;
esac
