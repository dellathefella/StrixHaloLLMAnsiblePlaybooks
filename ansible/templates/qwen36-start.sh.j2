#!/bin/bash
# =============================================================================
# qwen36-start.sh — Qwen3.6-35B-A3B (8-bit UD-Q8_K_XL) via latest llama.cpp
#
# Generated by the llama bootstrap playbook ({{ ansible_date_time.iso8601 }}).
#
# Optimized for Strix Halo (gfx1151) per the Frame.work LLM bench thread:
#   • Vulkan (Mesa RADV) wins tg + MoE pp; built Vulkan-only.
#   • MoE: 2^n batching (batch=256) + flash-attn on.
#   • --no-mmap loads weights into the unified 128GB shared pool.
#   • ~3B active params ≈ 3 GB/token ≈ 65-70 tok/s at ~215 GB/s.
#   • Qwen3.6 needs >= 128k ctx to preserve long-thinking behavior
#     (keep GEMMA-style ctx override at or above {{ qwen36_ctx }}).
#
# Env overrides: QWEN36_BIN/LIB/MODEL/CTX/PORT/HOST/DEVICE/BATCH/UBATCH/FA/MMAP/THREADS
# =============================================================================
set -euo pipefail

QWEN36_MODEL="${QWEN36_MODEL:-{{ llama_models_dir }}/{{ qwen36_model }}}"
QWEN36_BIN="${QWEN36_BIN:-{{ llama_bin }}}"
QWEN36_CTX="${QWEN36_CTX:-{{ qwen36_ctx }}}"
QWEN36_PORT="${QWEN36_PORT:-{{ qwen36_port }}}"
QWEN36_HOST="${QWEN36_HOST:-{{ qwen36_host }}}"
QWEN36_DEVICE="${QWEN36_DEVICE:-{{ qwen36_device }}}"
QWEN36_BATCH="${QWEN36_BATCH:-{{ qwen36_batch }}}"
QWEN36_UBATCH="${QWEN36_UBATCH:-{{ qwen36_ubatch }}}"
QWEN36_FA="${QWEN36_FA:-{{ qwen36_flash_attn }}}"
QWEN36_MMAP="${QWEN36_MMAP:-{{ qwen36_mmap }}}"
QWEN36_THREADS="${QWEN36_THREADS:-16}"

# --- llama.cpp shared libs (libllama-server-impl.so, libllama.so, libggml-vulkan.so)
#     install into $QWEN36_BIN/../lib; the binary has no rpath, so add it to the loader path ---
QWEN36_LIB="${QWEN36_LIB:-$(dirname "$QWEN36_BIN")/../lib}"
[ -d "$QWEN36_LIB" ] && export LD_LIBRARY_PATH="${QWEN36_LIB}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# --- Vulkan (Mesa RADV) runtime env for Strix Halo ---
export AMD_VULKAN_ICD=RADV
export RADV_PERFTEST="gpl,sam,nggc"
for _icd in /usr/share/vulkan/icd.d/*.json; do
  VK_ICD_FILENAMES="${VK_ICD_FILENAMES:+${VK_ICD_FILENAMES}:}${_icd}"
done
export VK_ICD_FILENAMES

# --- sanity ---
[ -x "$QWEN36_BIN" ] || { echo "llama-server not found: $QWEN36_BIN (run bootstrap)" >&2; exit 1; }
[ -f "$QWEN36_MODEL" ] || { echo "model not found: $QWEN36_MODEL" >&2; exit 1; }

# --- flag assembly (env-overridable) ---
FA_ARGS=()
[ "$QWEN36_FA" = "1" ] && FA_ARGS=(--flash-attn on)
MMAP_ARGS=(--no-mmap)
[ "$QWEN36_MMAP" = "1" ] && MMAP_ARGS=()

echo "Qwen3.6-35B-A3B (UD-Q8_K_XL) on $QWEN36_DEVICE, ctx=$QWEN36_CTX, b=$QWEN36_BATCH, ub=$QWEN36_UBATCH"
echo "Endpoint: http://$QWEN36_HOST:$QWEN36_PORT/v1   alias: qwen3.6-35b-a3b"

exec "$QWEN36_BIN" \
  --model "$QWEN36_MODEL" \
  --alias qwen3.6-35b-a3b \
  --device "$QWEN36_DEVICE" \
  --n-gpu-layers 999 \
  --ctx-size "$QWEN36_CTX" \
  --batch-size "$QWEN36_BATCH" \
  --ubatch-size "$QWEN36_UBATCH" \
  --threads "$QWEN36_THREADS" \
  --cont-batching \
  --host "$QWEN36_HOST" --port "$QWEN36_PORT" \
  "${FA_ARGS[@]}" "${MMAP_ARGS[@]}" \
  "$@"
