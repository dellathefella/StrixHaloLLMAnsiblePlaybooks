#!/bin/bash
# =============================================================================
# qwen35-397b-gptq-rccl-start.sh — Qwen3.5-397B RCCL cluster launch script
#
# Generated by the qwen35-397b-gptq-rccl bootstrap playbook ({{ ansible_date_time.iso8601 }}).
# One script for both nodes; choose the role via env:
#   QWEN35_397B_GPTQ_RCCL_ROLE=head    -> Machine 1: Ray head + vLLM server
#   QWEN35_397B_GPTQ_RCCL_ROLE=worker  -> Machine 2: joins the Ray head
#
# Requires the vllm_cluster container from the qwen35-397b-gptq-rccl bootstrap/setup.
# =============================================================================
set -euo pipefail

# --- role (env required) ---
QWEN35_397B_GPTQ_RCCL_ROLE="${QWEN35_397B_GPTQ_RCCL_ROLE:?set QWEN35_397B_GPTQ_RCCL_ROLE=head|worker}"

# --- baked config (override via env) ---
QWEN35_397B_GPTQ_RCCL_MODEL="${QWEN35_397B_GPTQ_RCCL_MODEL:-{{ qwen35_397b_gptq_rccl_model }}}"
QWEN35_397B_GPTQ_RCCL_PORT="${QWEN35_397B_GPTQ_RCCL_PORT:-{{ qwen35_397b_gptq_rccl_port }}}"
QWEN35_397B_GPTQ_RCCL_MAX_LEN="${QWEN35_397B_GPTQ_RCCL_MAX_LEN:-{{ qwen35_397b_gptq_rccl_max_model_len }}}"
QWEN35_397B_GPTQ_RCCL_TP="${QWEN35_397B_GPTQ_RCCL_TP:-{{ qwen35_397b_gptq_rccl_tp_size }}}"
QWEN35_397B_GPTQ_RCCL_GPU_UTIL="${QWEN35_397B_GPTQ_RCCL_GPU_UTIL:-{{ qwen35_397b_gptq_rccl_gpu_util }}}"
QWEN35_397B_GPTQ_RCCL_HEAD_IP="${QWEN35_397B_GPTQ_RCCL_HEAD_IP:-{{ qwen35_397b_gptq_rccl_head_ip }}}"
QWEN35_397B_GPTQ_RCCL_WORKER_IP="${QWEN35_397B_GPTQ_RCCL_WORKER_IP:-{{ qwen35_397b_gptq_rccl_worker_ip }}}"

case "$QWEN35_397B_GPTQ_RCCL_ROLE" in
  head)
    [ -n "$QWEN35_397B_GPTQ_RCCL_HEAD_IP" ] || { echo "QWEN35_397B_GPTQ_RCCL_HEAD_IP not set" >&2; exit 1; }
    echo "Starting Ray head on $QWEN35_397B_GPTQ_RCCL_HEAD_IP ..."
    sudo podman exec vllm_cluster ray start --head --port=6379 \
      --node-ip-address="$QWEN35_397B_GPTQ_RCCL_HEAD_IP" --num-gpus=1

    echo "Launching vLLM serve (detached)..."
    sudo podman exec -d vllm_cluster vllm serve "$QWEN35_397B_GPTQ_RCCL_MODEL" \
      --port "$QWEN35_397B_GPTQ_RCCL_PORT" --host 0.0.0.0 \
      --max-model-len "$QWEN35_397B_GPTQ_RCCL_MAX_LEN" \
      --gpu-memory-utilization "$QWEN35_397B_GPTQ_RCCL_GPU_UTIL" \
      --dtype float16 \
      --tensor-parallel-size "$QWEN35_397B_GPTQ_RCCL_TP" \
      --distributed-executor-backend ray \
      --enforce-eager \
      --language-model-only \
      --reasoning-parser qwen3

    echo "CLUSTER READY — OpenAI endpoint: http://$QWEN35_397B_GPTQ_RCCL_HEAD_IP:$QWEN35_397B_GPTQ_RCCL_PORT/v1"
    echo "WARNING [context] max-model-len $QWEN35_397B_GPTQ_RCCL_MAX_LEN is beyond the guide's tested 32768;"
    echo "   on a 2.5Gbps link KV sync scales with context — lower it if latency/OOM."
    ;;
  worker)
    [ -n "$QWEN35_397B_GPTQ_RCCL_HEAD_IP" ] || { echo "QWEN35_397B_GPTQ_RCCL_HEAD_IP not set" >&2; exit 1; }
    echo "Joining head $QWEN35_397B_GPTQ_RCCL_HEAD_IP:6379 as worker $QWEN35_397B_GPTQ_RCCL_WORKER_IP ..."
    sudo podman exec vllm_cluster ray start \
      --address="$QWEN35_397B_GPTQ_RCCL_HEAD_IP:6379" \
      --node-ip-address="$QWEN35_397B_GPTQ_RCCL_WORKER_IP" --num-gpus=1
    echo "Worker joined. Verify on the head: ray status (inside vllm_cluster)."
    echo "NOTE: worker uses the SAME context/model as the head; do not run vllm serve here."
    ;;
  *)
    echo "Unknown QWEN35_397B_GPTQ_RCCL_ROLE '$QWEN35_397B_GPTQ_RCCL_ROLE'" >&2; exit 1 ;;
esac
