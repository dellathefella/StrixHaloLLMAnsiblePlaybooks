#!/usr/bin/env bash
# =============================================================================
# qwen38-start.sh  —  Qwen3.8-27B q38rocm (ROCmFPX) launch
#
# Templated by ansible/bootstrap.yml (PLAY 5, qwen38 group) and dropped locally
# as scripts/qwen38-start.sh. Single-node server on the Strix Halo APU.
#
# Matches https://github.com/julianmb/q38rocm:
#   • Prebuilt ROCmFPX llama.cpp engine (dual ROCm + Vulkan)
#   • ROCmFP4_FAST 4-bit quant (13.55 GiB)
#   • MTP speculative decoding (ON by default, ~36 tok/s with Vulkan0)
#   • Asymmetric TurboQuant KV cache (K=q8_0, V=turbo4)
#
# Env overrides:
#   QWEN38_MODEL   model gguf path (default baked)
#   QWEN38_BIN     llama-server binary (default baked)
#   QWEN38_HOST    bind host (default baked)
#   QWEN38_PORT    serve port   (default baked)
#   QWEN38_CTX     context      (default baked 131072)
#   QWEN38_DEVICE  auto | Vulkan0 | ROCm0 | CPU (default baked)
#   QWEN38_MTP     1|0          MTP speculative decode on/off (default 1)
#   QWEN38_DRAFT_N draft depth  (default baked)
#   QWEN38_DRAFT_PMIN draft acceptance threshold (default baked)
#   QWEN38_KV_K    KV cache key type (default baked q8_0)
#   QWEN38_KV_V    KV cache value type (default baked turbo4)
# =============================================================================
set -euo pipefail

QWEN38_MODEL="${QWEN38_MODEL:-{{ qwen38_models_dir }}/{{ qwen38_model_file }}}"
QWEN38_BIN="${QWEN38_BIN:-{{ qwen38_bin }}}"
QWEN38_HOST="${QWEN38_HOST:-{{ qwen38_host }}}"
QWEN38_PORT="${QWEN38_PORT:-{{ qwen38_port }}}"
QWEN38_CTX="${QWEN38_CTX:-{{ qwen38_ctx }}}"
QWEN38_DEVICE="${QWEN38_DEVICE:-{{ qwen38_device }}}"
QWEN38_SLOTS="${QWEN38_SLOTS:-{{ qwen38_slots }}}"
QWEN38_BATCH="${QWEN38_BATCH:-{{ qwen38_batch }}}"
QWEN38_UBATCH="${QWEN38_UBATCH:-{{ qwen38_ubatch }}}"
QWEN38_MTP="${QWEN38_MTP:-1}"
QWEN38_DRAFT_N="${QWEN38_DRAFT_N:-{{ qwen38_draft_n }}}"
QWEN38_DRAFT_PMIN="${QWEN38_DRAFT_PMIN:-{{ qwen38_draft_pmin }}}"
QWEN38_KV_K="${QWEN38_KV_K:-{{ qwen38_kv_k }}}"
QWEN38_KV_V="${QWEN38_KV_V:-{{ qwen38_kv_v }}}"
QWEN38_REASONING_BUDGET="${QWEN38_REASONING_BUDGET:-{{ qwen38_reasoning_budget }}}"
QWEN38_TEMP="${QWEN38_TEMP:-{{ qwen38_temp }}}"
QWEN38_PRESENCE_PENALTY="${QWEN38_PRESENCE_PENALTY:-{{ qwen38_presence_penalty }}}"
QWEN38_REPEAT_PENALTY="${QWEN38_REPEAT_PENALTY:-{{ qwen38_repeat_penalty }}}"

# --- ROCmFPX / Strix Halo (gfx1151) runtime env ---
export HSA_OVERRIDE_GFX_VERSION=11.5.1
export GGML_HIP_ENABLE_UNIFIED_MEMORY=1
export HIP_VISIBLE_DEVICES=0
export ROCM_FLUSH_ACCEPT=1

# --- Vulkan RADV (Wave64 + KHR_coopmat) ICD ---
export AMD_VULKAN_ICD=RADV
export RADV_PERFTEST="gpl,sam,nggc"
# Dynamic ICD discovery (first found wins)
for icd in \
  "${VK_ICD_FILENAMES:-}" \
  "/usr/share/vulkan/icd.d/radeon_icd.x86_64.json" \
  "/usr/share/vulkan/icd.d/radeon_icd.json" \
  "/etc/vulkan/icd.d/radeon_icd.json" \
  "/etc/vulkan/icd.d/radeon_icd.x86_64.json"; do
  if [ -n "$icd" ] && [ -f "$icd" ]; then
    export VK_ICD_FILENAMES="$icd"
    break
  fi
done

# --- LD_LIBRARY_PATH: engine bin (shared .so) + ROCm runtime ---
QWEN38_ENGINE_LIB="{{ qwen38_engine_dir }}/bin"
ROCM_LIB=""
for d in /opt/rocm /opt/rocm-* /usr; do
  if [ -e "${d}/lib/libamdhip64.so.7" ] || [ -e "${d}/lib/libamdhip64.so" ]; then
    ROCM_LIB="$d/lib"; break
  fi
done
[ -z "$ROCM_LIB" ] && ROCM_LIB=$(ldconfig -p 2>/dev/null | grep -q 'libamdhip64.so.7' && echo /usr/lib || echo /usr/lib)
export LD_LIBRARY_PATH="${QWEN38_ENGINE_LIB}:${ROCM_LIB}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# --- CPU performance profile (does not survive reboot) ---
if [ "$(powerprofilesctl get)" != "performance" ] 2>/dev/null; then
  echo "qwen38-start: switching CPU to performance power profile (sudo)..." >&2
  sudo powerprofilesctl set performance || true
fi

# --- context sanity ---
case "$QWEN38_CTX" in
  ''|*[!0-9]*) echo "qwen38-start: QWEN38_CTX must be an integer (got '$QWEN38_CTX')" >&2; exit 2 ;;
esac

# --- sanity checks ---
[ -x "$QWEN38_BIN" ] || { echo "qwen38-start: llama-server not found at $QWEN38_BIN (engine download failed?)" >&2; exit 2; }
[ -f "$QWEN38_MODEL" ] || { echo "qwen38-start: model not found at $QWEN38_MODEL (download failed?)" >&2; exit 2; }

# --- device auto-detection (Vulkan0 vs ROCm0 vs CPU) ---
if [ "$QWEN38_DEVICE" = "auto" ]; then
  DEVICES="$("$QWEN38_BIN" --list-devices 2>/dev/null || true)"
  if echo "$DEVICES" | grep -q "Vulkan0"; then
    QWEN38_DEVICE="Vulkan0"
  elif echo "$DEVICES" | grep -q "ROCm0"; then
    QWEN38_DEVICE="ROCm0"
    echo "qwen38-start: [NOTICE] Vulkan0 not found; falling back to ROCm0 (~28 tok/s)." >&2
  else
    QWEN38_DEVICE="CPU"
    echo "qwen38-start: [WARN] No GPU backend found; running on CPU." >&2
  fi
fi

# --- MTP speculative decoding (ON by default) ---
MTP_ARGS=()
if [ "$QWEN38_MTP" = "1" ]; then
  MTP_ARGS=( --spec-type draft-mtp --spec-draft-n-max "$QWEN38_DRAFT_N" --spec-draft-p-min "$QWEN38_DRAFT_PMIN" )
fi

echo "qwen38-start: serving $QWEN38_MODEL ctx=$QWEN38_CTX device=$QWEN38_DEVICE port=$QWEN38_PORT MTP=$QWEN38_MTP" >&2

exec "$QWEN38_BIN" \
  --model "$QWEN38_MODEL" \
  --alias qwen3.8-27b \
  --device "$QWEN38_DEVICE" \
  --n-gpu-layers 99 \
  --flash-attn on \
  --parallel "$QWEN38_SLOTS" \
  --ctx-size "$QWEN38_CTX" \
  --batch-size "$QWEN38_BATCH" --ubatch-size "$QWEN38_UBATCH" \
  --threads 16 \
  --poll 100 \
  --cache-type-k "$QWEN38_KV_K" --cache-type-v "$QWEN38_KV_V" \
  --presence-penalty "$QWEN38_PRESENCE_PENALTY" \
  --repeat-penalty "$QWEN38_REPEAT_PENALTY" \
  --temperature "$QWEN38_TEMP" \
  --no-mmap \
  --cont-batching \
  --kv-unified \
  --ctxcp 0 --cram 0 --no-cache-prompt --no-cache-idle-slots \
  --host "$QWEN38_HOST" --port "$QWEN38_PORT" \
  "${MTP_ARGS[@]}" \
  --reasoning-budget "$QWEN38_REASONING_BUDGET" \
  "$@"
