#!/bin/bash
# =============================================================================
# step35flash-start.sh — Step 3.5 Flash smol-IQ3_KS (~81.5 GB) via latest llama.cpp
#
# Generated by the llama bootstrap playbook ({{ ansible_date_time.iso8601 }}).
#
# Step 3.5 Flash — 26B total / 11B active (MoE), 256K native context
#   (3:1 Sliding Window Attention ratio). ubergarm smol-IQ3_KS quant at ~3.05 BPW.
#
# Optimized for Strix Halo (gfx1151) — ROCm/HIP backend:
#   • ROCm 4.7× faster prompt processing, 65% less energy than Vulkan.
#   • MoE: batch=2048, ubatch=2048 (validated for 16k ctx; use ubatch=1024
#     for 256K context).
#   • --no-mmap loads weights into the unified 128GB shared pool.
#   • --cache-ram 0 prevents host/GPU memory competition on 128GB UMA.
#   • ~11B active params ≈ 11 GB/token ≈ 30-48 tok/s at ~215 GB/s.
#   • Reasoning: Step-style `<|begin_of_thought|>` / `<|end_of_thought|>` format.
#
# Env overrides: STEP35FLASH_BIN/LIB/MODEL/CTX/PORT/HOST/DEVICE/BATCH/UBATCH/FA/MMAP/THREADS
# =============================================================================
set -euo pipefail

STEP35FLASH_MODEL="${STEP35FLASH_MODEL:-{{ llama_models_dir }}/{{ step35flash_model }}}"
STEP35FLASH_BIN="${STEP35FLASH_BIN:-{{ llama_bin }}}"
STEP35FLASH_CTX="${STEP35FLASH_CTX:-{{ step35flash_ctx }}}"
STEP35FLASH_PORT="${STEP35FLASH_PORT:-{{ step35flash_port }}}"
STEP35FLASH_HOST="${STEP35FLASH_HOST:-{{ step35flash_host }}}"
STEP35FLASH_DEVICE="${STEP35FLASH_DEVICE:-{{ step35flash_device }}}"
STEP35FLASH_BATCH="${STEP35FLASH_BATCH:-{{ step35flash_batch }}}"
STEP35FLASH_UBATCH="${STEP35FLASH_UBATCH:-{{ step35flash_ubatch }}}"
STEP35FLASH_FA="${STEP35FLASH_FA:-{{ step35flash_flash_attn }}}"
STEP35FLASH_MMAP="${STEP35FLASH_MMAP:-{{ step35flash_mmap }}}"
STEP35FLASH_THREADS="${STEP35FLASH_THREADS:-32}"

# --- llama.cpp shared libs (libllama-server-impl.so, libllama.so, libggml-hip.so)
#     install into $STEP35FLASH_BIN/../lib; the binary has no rpath, so add it to the loader path ---
STEP35FLASH_LIB="${STEP35FLASH_LIB:-$(dirname "$STEP35FLASH_BIN")/../lib}"
[ -d "$STEP35FLASH_LIB" ] && export LD_LIBRARY_PATH="${STEP35FLASH_LIB}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# --- ROCm/HIP runtime env for Strix Halo ---
export HSA_ENABLE_SDMA=1
export HSA_FORCE_FINE_GRAIN_PCIE=1

# --- sanity ---
[ -x "$STEP35FLASH_BIN" ] || { echo "llama-server not found: $STEP35FLASH_BIN (run bootstrap)" >&2; exit 1; }
[ -f "$STEP35FLASH_MODEL" ] || { echo "model not found: $STEP35FLASH_MODEL" >&2; exit 1; }

# --- flag assembly (env-overridable) ---
FA_ARGS=()
[ "$STEP35FLASH_FA" = "1" ] && FA_ARGS=(--flash-attn on)
MMAP_ARGS=(--no-mmap)
[ "$STEP35FLASH_MMAP" = "1" ] && MMAP_ARGS=()

echo "Step 3.5 Flash (smol-IQ3_KS, ~81.5 GB, 11B active/26B total MoE) on $STEP35FLASH_DEVICE, ctx=$STEP35FLASH_CTX, b=$STEP35FLASH_BATCH, ub=$STEP35FLASH_UBATCH"
echo "Endpoint: http://$STEP35FLASH_HOST:$STEP35FLASH_PORT/v1   alias: step-3.5-flash"
echo "Reasoning: Step-style <|begin_of_thought|> / <|end_of_thought|> format. Sampling: temp=1.0, top_p=0.95, top_k=20."

exec "$STEP35FLASH_BIN" \
  --model "$STEP35FLASH_MODEL" \
  --alias step-3.5-flash \
  --device "$STEP35FLASH_DEVICE" \
  --n-gpu-layers 999 \
  --ctx-size "$STEP35FLASH_CTX" \
  --batch-size "$STEP35FLASH_BATCH" \
  --ubatch-size "$STEP35FLASH_UBATCH" \
  --threads "$STEP35FLASH_THREADS" \
  --cont-batching \
  --cache-ram 0 \
  --host "$STEP35FLASH_HOST" --port "$STEP35FLASH_PORT" \
  --temp 1.0 --top-p 0.95 --top-k 20 \
  "${FA_ARGS[@]}" "${MMAP_ARGS[@]}" \
  "$@"
