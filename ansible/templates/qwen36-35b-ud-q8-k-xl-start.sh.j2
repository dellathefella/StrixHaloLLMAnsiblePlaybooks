#!/bin/bash
# =============================================================================
# qwen36-35b-ud-q8-k-xl-start.sh — Qwen3.6-35B-A3B (llama.cpp ROCm/HIP + UD-Q8_K_XL quant)
#
# Generated by the qwen36-35b-ud-q8-k-xl bootstrap playbook ({{ ansible_date_time.iso8601 }}).
#
# Qwen3.6-35B-A3B (3x35B MoE, ~17.5B active params) on ROCm/HIP llama.cpp:
#   --ctx-size {{ qwen36_35b_ud_q8_k_xl_ctx }}   (native 32k context, YaRN extendable to 256k)
#   --n-gpu-layers 999                            (offload all layers to GPU)
#   --cache-type-k f16                            (16-bit KV cache — accuracy over speed)
#   --cache-type-v f16
#   --flash-attn on                               (Flash Attention via ROCm backend)
#
# Port: {{ qwen36_35b_ud_q8_k_xl_port }}
# Model: {{ qwen36_35b_ud_q8_k_xl_model }} (~35 GB, UD-Q8_K_XL quant)
#
# Override defaults via environment variables:
#   QWEN36_35B_UD_Q8_K_XL_BIN   = binary path
#   QWEN36_35B_UD_Q8_K_XL_MODEL = model filename (default: {{ qwen36_35b_ud_q8_k_xl_model }})
#   QWEN36_35B_UD_Q8_K_XL_CTX   = context window (default: {{ qwen36_35b_ud_q8_k_xl_ctx }})
#   QWEN36_35B_UD_Q8_K_XL_PORT  = HTTP port    (default: {{ qwen36_35b_ud_q8_k_xl_port }})
#   QWEN36_35B_UD_Q8_K_XL_N_GPU = layers to GPU (default: {{ qwen36_35b_ud_q8_k_xl_n_gpu }})
#   QWEN36_35B_UD_Q8_K_XL_THREADS = CPU threads (default: {{ qwen36_35b_ud_q8_k_xl_threads }})
#   QWEN36_35B_UD_Q8_K_XL_BATCH  = batch size  (default: {{ qwen36_35b_ud_q8_k_xl_batch }})
#   QWEN36_35B_UD_Q8_K_XL_UBATCH = ubatch size (default: {{ qwen36_35b_ud_q8_k_xl_ubatch }})
# =============================================================================
set -euo pipefail

# --- baked config (override via env) ---
QWEN36_35B_UD_Q8_K_XL_MODEL="${QWEN36_35B_UD_Q8_K_XL_MODEL:-{{ llama_models_dir }}/{{ qwen36_35b_ud_q8_k_xl_model }}}"
QWEN36_35B_UD_Q8_K_XL_BIN="${QWEN36_35B_UD_Q8_K_XL_BIN:-{{ llama_bin }}}"
QWEN36_35B_UD_Q8_K_XL_CTX="${QWEN36_35B_UD_Q8_K_XL_CTX:-{{ qwen36_35b_ud_q8_k_xl_ctx }}}"
QWEN36_35B_UD_Q8_K_XL_PORT="${QWEN36_35B_UD_Q8_K_XL_PORT:-{{ qwen36_35b_ud_q8_k_xl_port }}}"
QWEN36_35B_UD_Q8_K_XL_HOST="${QWEN36_35B_UD_Q8_K_XL_HOST:-{{ qwen36_35b_ud_q8_k_xl_host }}}"
QWEN36_35B_UD_Q8_K_XL_DEVICE="${QWEN36_35B_UD_Q8_K_XL_DEVICE:-{{ qwen36_35b_ud_q8_k_xl_device }}}"
QWEN36_35B_UD_Q8_K_XL_BATCH="${QWEN36_35B_UD_Q8_K_XL_BATCH:-{{ qwen36_35b_ud_q8_k_xl_batch }}}"
QWEN36_35B_UD_Q8_K_XL_UBATCH="${QWEN36_35B_UD_Q8_K_XL_UBATCH:-{{ qwen36_35b_ud_q8_k_xl_ubatch }}}"
QWEN36_35B_UD_Q8_K_XL_FA="${QWEN36_35B_UD_Q8_K_XL_FA:-{{ qwen36_35b_ud_q8_k_xl_flash_attn }}}"
QWEN36_35B_UD_Q8_K_XL_MMAP="${QWEN36_35B_UD_Q8_K_XL_MMAP:-{{ qwen36_35b_ud_q8_k_xl_mmap }}}"
QWEN36_35B_UD_Q8_K_XL_THREADS="${QWEN36_35B_UD_Q8_K_XL_THREADS:-{{ qwen36_35b_ud_q8_k_xl_threads }}}"

# --- llama.cpp shared libs (libllama-server-impl.so, libllama.so, libggml-hip.so) ---
QWEN36_35B_UD_Q8_K_XL_LIB="${QWEN36_35B_UD_Q8_K_XL_LIB:-$(dirname "$QWEN36_35B_UD_Q8_K_XL_BIN")/../lib}"
[ -d "$QWEN36_35B_UD_Q8_K_XL_LIB" ] && export LD_LIBRARY_PATH="${QWEN36_35B_UD_Q8_K_XL_LIB}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# --- ROCm/HIP runtime env ---
export HSA_ENABLE_SDMA=1
export HSA_FORCE_FINE_GRAIN_PCIE=1

# --- sanity ---
[ -x "$QWEN36_35B_UD_Q8_K_XL_BIN" ] || { echo "llama-server not found: $QWEN36_35B_UD_Q8_K_XL_BIN (run bootstrap)" >&2; exit 1; }
[ -f "$QWEN36_35B_UD_Q8_K_XL_MODEL" ] || { echo "model not found: $QWEN36_35B_UD_Q8_K_XL_MODEL" >&2; exit 1; }

# --- flag assembly (env-overridable) ---
FA_ARGS=()
[ "$QWEN36_35B_UD_Q8_K_XL_FA" = "1" ] && FA_ARGS=(--flash-attn on)
MMAP_ARGS=(--no-mmap)
[ "$QWEN36_35B_UD_Q8_K_XL_MMAP" = "1" ] && MMAP_ARGS=()

echo "Qwen3.6-35B-A3B (UD-Q8_K_XL) on $QWEN36_35B_UD_Q8_K_XL_DEVICE, ctx=$QWEN36_35B_UD_Q8_K_XL_CTX, b=$QWEN36_35B_UD_Q8_K_XL_BATCH, ub=$QWEN36_35B_UD_Q8_K_XL_UBATCH"
echo "Endpoint: http://$QWEN36_35B_UD_Q8_K_XL_HOST:$QWEN36_35B_UD_Q8_K_XL_PORT/v1   alias: qwen3.6-35b-ud-q8-k-xl"

exec "$QWEN36_35B_UD_Q8_K_XL_BIN" \
  --model "$QWEN36_35B_UD_Q8_K_XL_MODEL" \
  --alias qwen3.6-35b-ud-q8-k-xl \
  --device "$QWEN36_35B_UD_Q8_K_XL_DEVICE" \
  --n-gpu-layers 999 \
  --ctx-size "$QWEN36_35B_UD_Q8_K_XL_CTX" \
  --batch-size "$QWEN36_35B_UD_Q8_K_XL_BATCH" \
  --ubatch-size "$QWEN36_35B_UD_Q8_K_XL_UBATCH" \
  --threads "$QWEN36_35B_UD_Q8_K_XL_THREADS" \
  --cont-batching \
  --cache-ram 0 \
  --host "$QWEN36_35B_UD_Q8_K_XL_HOST" --port "$QWEN36_35B_UD_Q8_K_XL_PORT" \
  "${FA_ARGS[@]}" "${MMAP_ARGS[@]}" \
  "$@"
