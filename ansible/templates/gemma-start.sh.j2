#!/bin/bash
# =============================================================================
# gemma-start.sh — Gemma 4 26B-A4B (8-bit UD-Q8_K_XL) via latest llama.cpp
#
# Generated by the llama bootstrap playbook ({{ ansible_date_time.iso8601 }}).
#
# Optimized for Strix Halo (Ryzen AI Max / gfx1151) per the Frame.work LLM
# bench thread (community.frame.work/t/72521, user lhl):
#   • Vulkan (Mesa RADV) wins token-gen + MoE prompt on Strix Halo; ROCm
#     7.x official had a pp regression. We build llama.cpp with Vulkan only.
#   • MoE: 2^n batching (batch=256) + flash-attn on.
#   • --no-mmap loads all weights into the unified 128GB shared pool.
#   • tg is memory-bandwidth bound (~215 GB/s): 8-bit UD-Q8_K_XL keeps
#     active ~4B params ≈ 4 GB/token ≈ 40-50 tok/s; ~2x BF16.
#
# Env overrides: GEMMA_BIN/MODEL/CTX/PORT/HOST/DEVICE/BATCH/UBATCH/FA/MMAP/THREADS
# =============================================================================
set -euo pipefail

GEMMA_MODEL="${GEMMA_MODEL:-{{ llama_models_dir }}/{{ gemma_model }}}"
GEMMA_BIN="${GEMMA_BIN:-{{ llama_bin }}}"
GEMMA_CTX="${GEMMA_CTX:-{{ gemma_ctx }}}"
GEMMA_PORT="${GEMMA_PORT:-{{ gemma_port }}}"
GEMMA_HOST="${GEMMA_HOST:-{{ gemma_host }}}"
GEMMA_DEVICE="${GEMMA_DEVICE:-{{ gemma_device }}}"
GEMMA_BATCH="${GEMMA_BATCH:-{{ gemma_batch }}}"
GEMMA_UBATCH="${GEMMA_UBATCH:-{{ gemma_ubatch }}}"
GEMMA_FA="${GEMMA_FA:-{{ gemma_flash_attn }}}"
GEMMA_MMAP="${GEMMA_MMAP:-{{ gemma_mmap }}}"
GEMMA_THREADS="${GEMMA_THREADS:-16}"

# --- Vulkan (Mesa RADV) runtime env for Strix Halo ---
export AMD_VULKAN_ICD=RADV
export RADV_PERFTEST="gpl,sam,nggc"
# discover all ICDs (RADV + AMD pro) so Vulkan0 is picked; RADV is fastest here
for _icd in /usr/share/vulkan/icd.d/*.json; do
  VK_ICD_FILENAMES="${VK_ICD_FILENAMES:+${VK_ICD_FILENAMES}:}${_icd}"
done
export VK_ICD_FILENAMES

# --- sanity ---
[ -x "$GEMMA_BIN" ] || { echo "llama-server not found: $GEMMA_BIN (run bootstrap)" >&2; exit 1; }
[ -f "$GEMMA_MODEL" ] || { echo "model not found: $GEMMA_MODEL" >&2; exit 1; }

# --- flag assembly (env-overridable) ---
FA_ARGS=()
[ "$GEMMA_FA" = "1" ] && FA_ARGS=(--flash-attn on)
MMAP_ARGS=(--no-mmap)
[ "$GEMMA_MMAP" = "1" ] && MMAP_ARGS=()

echo "Gemma 4 26B-A4B (UD-Q8_K_XL) on $GEMMA_DEVICE, ctx=$GEMMA_CTX, b=$GEMMA_BATCH, ub=$GEMMA_UBATCH"
echo "Endpoint: http://$GEMMA_HOST:$GEMMA_PORT/v1   alias: gemma-4-26b-a4b"

exec "$GEMMA_BIN" \
  --model "$GEMMA_MODEL" \
  --alias gemma-4-26b-a4b \
  --device "$GEMMA_DEVICE" \
  --n-gpu-layers 999 \
  --ctx-size "$GEMMA_CTX" \
  --batch-size "$GEMMA_BATCH" \
  --ubatch-size "$GEMMA_UBATCH" \
  --threads "$GEMMA_THREADS" \
  --cont-batching \
  --host "$GEMMA_HOST" --port "$GEMMA_PORT" \
  "${FA_ARGS[@]}" "${MMAP_ARGS[@]}" \
  "$@"
