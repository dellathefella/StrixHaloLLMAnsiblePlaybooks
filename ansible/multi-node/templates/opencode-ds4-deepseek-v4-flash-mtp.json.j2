{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ds4-deepseek-v4-flash-mtp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek V4 Flash (ds4, 2-node pipeline + MTP)",
      "options": {
        "baseURL": "http://{{ ds4_head_ansible_host }}:{{ ds4_api_port }}/v1",
        "apiKey": "dsv4-local"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (ds4 2-node pipeline + MTP)",
          "reasoning": true,
          "limit": {
            "context": {{ ds4_ctx }},
            "output": {{ ds4_max_tokens }}
          },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 }
        }
      }
    }
  }
}
