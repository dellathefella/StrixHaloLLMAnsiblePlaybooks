#!/bin/bash
# =============================================================================
# vllm-rccl-moe-start.sh — multi-node vLLM + Ray + RCCL MoE launch script
#
# Generated by the vllm-rccl-moe bootstrap playbook ({{ ansible_date_time.iso8601 }}).
# Profile: {{ active_profile }} — {{ vllm_moe_profiles[active_profile].display }}
# One script for both nodes; choose the role via env:
#   VLLM_RCCL_MOE_ROLE=head    -> node 1: Ray head + vllm serve
#   VLLM_RCCL_MOE_ROLE=worker  -> node 2: joins the Ray head
#
# Requires the vllm_cluster container from the vllm-rccl-moe track bootstrap
# (NCCL_SOCKET_IFNAME / GLOO_SOCKET_IFNAME are baked into that container —
# re-run the track after changing the link, e.g. after bringing up the
# Thunderbolt link via ansible/multi-node/setup-thunderbolt-net.yml).
#
# Switch profile: re-run the track playbook with -e active_profile=<name>.
# =============================================================================
set -euo pipefail

# --- role (env required) ---
VLLM_RCCL_MOE_ROLE="${VLLM_RCCL_MOE_ROLE:?set VLLM_RCCL_MOE_ROLE=head|worker}"

# --- baked config (override via env) ---
VLLM_RCCL_MOE_MODEL="${VLLM_RCCL_MOE_MODEL:-{{ vllm_moe_profiles[active_profile].hf_repo }}}"
VLLM_RCCL_MOE_PORT="${VLLM_RCCL_MOE_PORT:-{{ vllm_moe_port }}}"
VLLM_RCCL_MOE_MAX_LEN="${VLLM_RCCL_MOE_MAX_LEN:-{{ vllm_moe_profiles[active_profile].max_model_len }}}"
VLLM_RCCL_MOE_TP="${VLLM_RCCL_MOE_TP:-{{ vllm_moe_tp_size }}}"
VLLM_RCCL_MOE_GPU_UTIL="${VLLM_RCCL_MOE_GPU_UTIL:-{{ vllm_moe_gpu_util }}}"
VLLM_RCCL_MOE_DTYPE="${VLLM_RCCL_MOE_DTYPE:-{{ vllm_moe_profiles[active_profile].dtype }}}"
VLLM_RCCL_MOE_EXTRA_ARGS="${VLLM_RCCL_MOE_EXTRA_ARGS:-{{ vllm_moe_profiles[active_profile].extra_serve_args | default('') }}}"
VLLM_RCCL_MOE_HEAD_IP="${VLLM_RCCL_MOE_HEAD_IP:-{{ vllm_moe_head_ip }}}"
VLLM_RCCL_MOE_WORKER_IP="${VLLM_RCCL_MOE_WORKER_IP:-{{ vllm_moe_worker_ip }}}"

case "$VLLM_RCCL_MOE_ROLE" in
  head)
    [ -n "$VLLM_RCCL_MOE_HEAD_IP" ] || { echo "VLLM_RCCL_MOE_HEAD_IP not set" >&2; exit 1; }
    echo "Starting Ray head on $VLLM_RCCL_MOE_HEAD_IP ..."
    sudo podman exec vllm_cluster ray start --head --port=6379 \
      --node-ip-address="$VLLM_RCCL_MOE_HEAD_IP" --num-gpus=1

    echo "Launching vLLM serve (detached) — profile {{ active_profile }} ..."
    # shellcheck disable=SC2086  # EXTRA_ARGS is intentionally word-split
    sudo podman exec -d vllm_cluster vllm serve "$VLLM_RCCL_MOE_MODEL" \
      --port "$VLLM_RCCL_MOE_PORT" --host 0.0.0.0 \
      --max-model-len "$VLLM_RCCL_MOE_MAX_LEN" \
      --gpu-memory-utilization "$VLLM_RCCL_MOE_GPU_UTIL" \
      --dtype "$VLLM_RCCL_MOE_DTYPE" \
      --tensor-parallel-size "$VLLM_RCCL_MOE_TP" \
      --distributed-executor-backend ray \
      --enforce-eager \
      $VLLM_RCCL_MOE_EXTRA_ARGS

    echo "CLUSTER READY (when warm) — OpenAI endpoint: http://$VLLM_RCCL_MOE_HEAD_IP:$VLLM_RCCL_MOE_PORT/v1"
    echo "Health poll:  curl -s http://$VLLM_RCCL_MOE_HEAD_IP:$VLLM_RCCL_MOE_PORT/health"
    echo "Logs:         sudo podman logs -f vllm_cluster"
    echo "NOTE: first serve downloads the model into ~/.local/share/vLLM/models (HF_HOME)."
    ;;
  worker)
    [ -n "$VLLM_RCCL_MOE_HEAD_IP" ] || { echo "VLLM_RCCL_MOE_HEAD_IP not set" >&2; exit 1; }
    [ -n "$VLLM_RCCL_MOE_WORKER_IP" ] || { echo "VLLM_RCCL_MOE_WORKER_IP not set" >&2; exit 1; }
    echo "Joining head $VLLM_RCCL_MOE_HEAD_IP:6379 as worker $VLLM_RCCL_MOE_WORKER_IP ..."
    sudo podman exec vllm_cluster ray start \
      --address="$VLLM_RCCL_MOE_HEAD_IP:6379" \
      --node-ip-address="$VLLM_RCCL_MOE_WORKER_IP" --num-gpus=1
    echo "Worker joined. Verify on the head: sudo podman exec vllm_cluster ray status"
    echo "NOTE: worker uses the SAME model/ctx as the head; do not run vllm serve here."
    ;;
  *)
    echo "Unknown VLLM_RCCL_MOE_ROLE '$VLLM_RCCL_MOE_ROLE'" >&2; exit 1 ;;
esac
