#!/bin/bash
# =============================================================================
# ds4-c-iq2xxs-start.sh — DeepSeek V4 Flash (ds4.c engine + IQ2XXS quant)
#
# Generated by the ds4-c-iq2xxs bootstrap playbook ({{ ansible_date_time.iso8601 }}).
# One script for both nodes; choose the role via env:
#   DS4_C_IQ2XXS_ROLE=single      -> standalone IQ2_XXS server (single node, AMD-guide default)
#   DS4_C_IQ2XXS_ROLE=coordinator -> multi-node coordinator (layers 0:21, listens)
#   DS4_C_IQ2XXS_ROLE=worker      -> multi-node worker (layers 22:output, connects)
#
# Single-node uses the IQ2XXS imatrix quant at {{ ds4_c_iq2xxs_ctx_single }} context
# (AMD playbook default for a 128 GB node). Multi-node uses the Q4KExperts
# quant; all nodes must use the SAME --ctx.
#
# MTP speculative decoding is DISABLED by default (stability). Enable with
# DS4_C_IQ2XXS_USE_MTP=1 if you want it (negatively affects stability, small speed gain).
#
# Run inside the ds4-c-iq2xxs distrobox (container names, not image names — the toolbox
# create tasks in ds4-c-iq2xxs.yml name them ds4-c-iq2xxs-rocm-7.14 / ds4-c-iq2xxs-multi-node-rocm-7.14):
#   distrobox enter <toolbox> -- bash /path/to/ds4-c-iq2xxs-start.sh
# (container name is baked below; override with DS4_C_IQ2XXS_TOOLBOX_SINGLE/MULTI if needed)
# =============================================================================
set -euo pipefail

# --- role (env required) ---
DS4_C_IQ2XXS_ROLE="${DS4_C_IQ2XXS_ROLE:?set DS4_C_IQ2XXS_ROLE=single|coordinator|worker}"

# --- baked config (override via env) ---
DS4_C_IQ2XXS_SINGLE_MODEL="${DS4_C_IQ2XXS_SINGLE_MODEL:-{{ ds4_c_iq2xxs_single_model }}}"
DS4_C_IQ2XXS_MULTI_MODEL="${DS4_C_IQ2XXS_MULTI_MODEL:-{{ ds4_c_iq2xxs_multi_model }}}"
DS4_C_IQ2XXS_MTP="${DS4_C_IQ2XXS_MTP:-{{ ds4_c_iq2xxs_mtp_model }}}"
DS4_C_IQ2XXS_USE_MTP="${DS4_C_IQ2XXS_USE_MTP:-0}"                       # disabled by default
DS4_C_IQ2XXS_CTX_SINGLE="${DS4_C_IQ2XXS_CTX_SINGLE:-{{ ds4_c_iq2xxs_ctx_single }}}"
DS4_C_IQ2XXS_CTX="${DS4_C_IQ2XXS_CTX:-{{ ds4_c_iq2xxs_ctx }}}"
DS4_C_IQ2XXS_PORT="${DS4_C_IQ2XXS_PORT:-{{ ds4_c_iq2xxs_port }}}"
DS4_C_IQ2XXS_COORD_IP="${DS4_C_IQ2XXS_COORD_IP:-{{ ds4_c_iq2xxs_coord_ip }}}"
DS4_C_IQ2XXS_COORD_PORT="${DS4_C_IQ2XXS_COORD_PORT:-{{ ds4_c_iq2xxs_coord_port }}}"
DS4_C_IQ2XXS_MODELS_DIR="${DS4_C_IQ2XXS_MODELS_DIR:-{{ ds4_c_iq2xxs_models_dir }}}"
DS4_C_IQ2XXS_TOOLBOX_SINGLE="${DS4_C_IQ2XXS_TOOLBOX_SINGLE:-ds4-c-iq2xxs-rocm-7.14}"
DS4_C_IQ2XXS_TOOLBOX_MULTI="${DS4_C_IQ2XXS_TOOLBOX_MULTI:-ds4-c-iq2xxs-multi-node-rocm-7.14}"

# --- optional MTP (speculative decoding) args ---
MTP_ARGS=""
[ "$DS4_C_IQ2XXS_USE_MTP" = "1" ] && MTP_ARGS="--mtp $DS4_C_IQ2XXS_MODELS_DIR/$DS4_C_IQ2XXS_MTP"
COORD_MTP_ARGS=""
[ "$DS4_C_IQ2XXS_USE_MTP" = "1" ] && COORD_MTP_ARGS="--mtp $DS4_C_IQ2XXS_MODELS_DIR/$DS4_C_IQ2XXS_MTP --mtp-draft 1"

case "$DS4_C_IQ2XXS_ROLE" in
  single)
    echo "Starting ds4-c-iq2xxs SINGLE-NODE server (IQ2XXS, ctx=$DS4_C_IQ2XXS_CTX_SINGLE) on 0.0.0.0:$DS4_C_IQ2XXS_PORT ..."
    distrobox enter "$DS4_C_IQ2XXS_TOOLBOX_SINGLE" -- \
      ds4-server -m "$DS4_C_IQ2XXS_MODELS_DIR/$DS4_C_IQ2XXS_SINGLE_MODEL" --ctx "$DS4_C_IQ2XXS_CTX_SINGLE" \
        --host 0.0.0.0 --port "$DS4_C_IQ2XXS_PORT" $MTP_ARGS
    echo "Endpoint: http://localhost:$DS4_C_IQ2XXS_PORT/v1"
    ;;
  coordinator)
    [ -n "$DS4_C_IQ2XXS_COORD_IP" ] || { echo "DS4_C_IQ2XXS_COORD_IP not set" >&2; exit 1; }
    echo "Starting ds4-c-iq2xxs COORDINATOR (Q4KExperts, ctx=$DS4_C_IQ2XXS_CTX, layers 0:21) on $DS4_C_IQ2XXS_COORD_IP:$DS4_C_IQ2XXS_COORD_PORT ..."
    distrobox enter "$DS4_C_IQ2XXS_TOOLBOX_MULTI" -- \
      ds4-server -m "$DS4_C_IQ2XXS_MODELS_DIR/$DS4_C_IQ2XXS_MULTI_MODEL" --ctx "$DS4_C_IQ2XXS_CTX" \
        --role coordinator --layers 0:21 \
        --listen "$DS4_C_IQ2XXS_COORD_IP" "$DS4_C_IQ2XXS_COORD_PORT" $COORD_MTP_ARGS
    ;;
  worker)
    [ -n "$DS4_C_IQ2XXS_COORD_IP" ] || { echo "DS4_C_IQ2XXS_COORD_IP not set" >&2; exit 1; }
    echo "Starting ds4-c-iq2xxs WORKER (Q4KExperts, ctx=$DS4_C_IQ2XXS_CTX, layers 22:output) -> $DS4_C_IQ2XXS_COORD_IP:$DS4_C_IQ2XXS_COORD_PORT ..."
    distrobox enter "$DS4_C_IQ2XXS_TOOLBOX_MULTI" -- \
      ds4-server -m "$DS4_C_IQ2XXS_MODELS_DIR/$DS4_C_IQ2XXS_MULTI_MODEL" --ctx "$DS4_C_IQ2XXS_CTX" \
        --role worker --layers 22:output \
        --coordinator "$DS4_C_IQ2XXS_COORD_IP" "$DS4_C_IQ2XXS_COORD_PORT" $MTP_ARGS
    ;;
  *)
    echo "Unknown DS4_C_IQ2XXS_ROLE '$DS4_C_IQ2XXS_ROLE'" >&2; exit 1 ;;
esac
