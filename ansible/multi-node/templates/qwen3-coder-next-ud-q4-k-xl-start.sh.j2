#!/bin/bash
# =============================================================================
# qwen3-coder-next-ud-q4-k-xl-start.sh — Qwen3-Coder-Next (UD-Q4_K_XL)
#
# Generated by the qwen3-coder-next-ud-q4-k-xl bootstrap playbook ({{ ansible_date_time.iso8601 }}).
#
# Qwen3-Coder-Next: specialized coding model
# Quant: UD-Q4_K_XL (single GGUF, from unsloth/Qwen3-Coder-Next-GGUF)
# Backend: ROCm/HIP with graph optimization
#
# Key settings:
#   --ctx-size {{ qwen3_coder_next_ud_q4_k_xl_ctx }}   (262k native ceiling)
#   --n-gpu-layers {{ qwen3_coder_next_ud_q4_k_xl_n_gpu }}  (all layers)
#   --cache-type-k q4_0                                   (q4_0 KV for ~47% smaller cache)
#   --cache-type-v q4_0
#   --flash-attn on
# =============================================================================
set -euo pipefail

# --- baked config (override via env) ---
QWEN3_CODER_NEXT_UD_Q4_K_XL_MODEL="${QWEN3_CODER_NEXT_UD_Q4_K_XL_MODEL:-{{ llama_common_models_dir }}/{{ qwen3_coder_next_ud_q4_k_xl_model }}}"
QWEN3_CODER_NEXT_UD_Q4_K_XL_BIN="${QWEN3_CODER_NEXT_UD_Q4_K_XL_BIN:-{{ qwen3_coder_next_ud_q4_k_xl_engine_bin }}}"
QWEN3_CODER_NEXT_UD_Q4_K_XL_CTX="${QWEN3_CODER_NEXT_UD_Q4_K_XL_CTX:-{{ qwen3_coder_next_ud_q4_k_xl_ctx }}}"
QWEN3_CODER_NEXT_UD_Q4_K_XL_PORT="${QWEN3_CODER_NEXT_UD_Q4_K_XL_PORT:-{{ qwen3_coder_next_ud_q4_k_xl_port }}}"
QWEN3_CODER_NEXT_UD_Q4_K_XL_HOST="${QWEN3_CODER_NEXT_UD_Q4_K_XL_HOST:-{{ qwen3_coder_next_ud_q4_k_xl_host }}}"
QWEN3_CODER_NEXT_UD_Q4_K_XL_DEVICE="${QWEN3_CODER_NEXT_UD_Q4_K_XL_DEVICE:-{{ qwen3_coder_next_ud_q4_k_xl_device }}}"
QWEN3_CODER_NEXT_UD_Q4_K_XL_N_GPU="${QWEN3_CODER_NEXT_UD_Q4_K_XL_N_GPU:-{{ qwen3_coder_next_ud_q4_k_xl_n_gpu }}}"
QWEN3_CODER_NEXT_UD_Q4_K_XL_THREADS="${QWEN3_CODER_NEXT_UD_Q4_K_XL_THREADS:-{{ qwen3_coder_next_ud_q4_k_xl_threads }}}"

# --- llama.cpp shared libs for this track ---
QWEN3_CODER_NEXT_UD_Q4_K_XL_LIB="${QWEN3_CODER_NEXT_UD_Q4_K_XL_LIB:-$(dirname "$QWEN3_CODER_NEXT_UD_Q4_K_XL_BIN")/../lib}"
[ -d "$QWEN3_CODER_NEXT_UD_Q4_K_XL_LIB" ] && export LD_LIBRARY_PATH="${QWEN3_CODER_NEXT_UD_Q4_K_XL_LIB}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# --- ROCm/HIP runtime env ---
export HSA_ENABLE_SDMA=0
export HSA_XNACK=1

# --- sanity ---
[ -x "$QWEN3_CODER_NEXT_UD_Q4_K_XL_BIN" ] || { echo "llama-server not found: $QWEN3_CODER_NEXT_UD_Q4_K_XL_BIN (run bootstrap)" >&2; exit 1; }
[ -f "$QWEN3_CODER_NEXT_UD_Q4_K_XL_MODEL" ] || { echo "model not found: $QWEN3_CODER_NEXT_UD_Q4_K_XL_MODEL" >&2; exit 1; }

echo "Qwen3-Coder-Next (UD-Q4_K_XL) on $QWEN3_CODER_NEXT_UD_Q4_K_XL_DEVICE, ctx=$QWEN3_CODER_NEXT_UD_Q4_K_XL_CTX, n-gpu=$QWEN3_CODER_NEXT_UD_Q4_K_XL_N_GPU"
echo "ROCm/HIP — 262k native ctx, q4_0 KV"
echo "Endpoint: http://$QWEN3_CODER_NEXT_UD_Q4_K_XL_HOST:$QWEN3_CODER_NEXT_UD_Q4_K_XL_PORT/v1   alias: qwen3-coder-next"

exec "$QWEN3_CODER_NEXT_UD_Q4_K_XL_BIN" \
  --model "$QWEN3_CODER_NEXT_UD_Q4_K_XL_MODEL" \
  --alias qwen3-coder-next-ud-q4-k-xl \
  --device "$QWEN3_CODER_NEXT_UD_Q4_K_XL_DEVICE" \
  --n-gpu-layers "$QWEN3_CODER_NEXT_UD_Q4_K_XL_N_GPU" \
  --ctx-size "$QWEN3_CODER_NEXT_UD_Q4_K_XL_CTX" \
  --cache-type-k q4_0 \
  --cache-type-v q4_0 \
  --threads "$QWEN3_CODER_NEXT_UD_Q4_K_XL_THREADS" \
  --flash-attn on \
  --load-mode mmap \
  --host "$QWEN3_CODER_NEXT_UD_Q4_K_XL_HOST" --port "$QWEN3_CODER_NEXT_UD_Q4_K_XL_PORT" \
  "$@"
