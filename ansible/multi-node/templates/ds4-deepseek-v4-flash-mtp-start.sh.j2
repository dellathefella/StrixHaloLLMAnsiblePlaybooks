#!/bin/bash
# =============================================================================
# ds4-deepseek-v4-flash-mtp-start.sh — 2-node ds4 (DeepSeek V4 Flash) launch
#
# Generated by the ds4-deepseek-v4-flash-mtp bootstrap playbook ({{ ansible_date_time.iso8601 }}).
# One script for both nodes; choose the role via env:
#   DS4_ROLE=head    -> node 1 (halo0): ds4-server coordinator, layers 0:21,
#                       MTP drafter, OpenAI API on port {{ ds4_api_port }}
#   DS4_ROLE=worker  -> node 2 (halo1): ds4-server worker, layers 22:output,
#                       joins the coordinator on port {{ ds4_pp_port }}
#
# Start the HEAD first, then the WORKER. The pipeline channel rides the
# Thunderbolt link (tb*, ~40 Gbps) when up — see setup-thunderbolt-net.yml;
# falls back to the 2.5Gbe NIC.
#
# Requires the {{ ds4_cluster_name }} container from the ds4-deepseek-v4-flash-mtp
# track bootstrap (image {{ ds4_container }}). The playbook downloads model
# weights into ~/ds4 on the host BEFORE the container is launched — the
# ~153 GB main GGUF on BOTH nodes, the ~3.6 GB MTP drafter on the head only —
# and the container bind-mounts that same host path read-only, so the path
# is identical inside and outside the container. This script only checks the
# files are there; re-run the playbook if either is missing.
#
# MTP is optional: the coordinator needs the ~153 GB main model to serve
# anything, but the ~3.6 GB drafter only adds speculative decoding on top —
# if it's missing, the coordinator starts WITHOUT --mtp/--mtp-model rather
# than refusing to serve the model at all.
#
# The playbook never launches servers: this is where the cluster comes up.
# =============================================================================
set -euo pipefail

# --- role (env required) ---
DS4_ROLE="${DS4_ROLE:?set DS4_ROLE=head|worker}"

# --- baked config (override via env) ---
DS4_MODELS_DIR="${DS4_MODELS_DIR:-{{ ds4_models_dir }}}"
DS4_HF_REPO="${DS4_HF_REPO:-{{ ds4_hf_repo }}}"
DS4_MODEL_FILE="${DS4_MODEL_FILE:-{{ ds4_model_file }}}"
DS4_MTP_FILE="${DS4_MTP_FILE:-{{ ds4_mtp_file }}}"
DS4_CTX="${DS4_CTX:-{{ ds4_ctx }}}"
DS4_MTP_DRAFT="${DS4_MTP_DRAFT:-{{ ds4_mtp_draft }}}"
DS4_LAYERS_HEAD="${DS4_LAYERS_HEAD:-{{ ds4_layers_head }}}"
DS4_LAYERS_WORKER="${DS4_LAYERS_WORKER:-{{ ds4_layers_worker }}}"
DS4_PP_PORT="${DS4_PP_PORT:-{{ ds4_pp_port }}}"
DS4_API_PORT="${DS4_API_PORT:-{{ ds4_api_port }}}"
DS4_HEAD_IP="${DS4_HEAD_IP:-{{ ds4_head_ip }}}"
DS4_WORKER_IP="${DS4_WORKER_IP:-{{ ds4_worker_ip }}}"
CONTAINER="{{ ds4_cluster_name }}"
SERVER="/usr/local/bin/ds4-server"

MODEL_PATH="${DS4_MODELS_DIR}/${DS4_MODEL_FILE}"
MTP_PATH="${DS4_MODELS_DIR}/${DS4_MTP_FILE}"

ensure_container() {
  if [ "$(sudo podman ps --filter name=${CONTAINER} --format '{{ '{{.Names}}' }}')" = "${CONTAINER}" ]; then
    return 0
  fi
  echo "Container ${CONTAINER} is not running — starting it ..." >&2
  sudo podman start "${CONTAINER}"
}

# The playbook downloads model weights on the host before the container ever
# starts (retried with/without an HF token); the container only bind-mounts
# them read-only. So this just verifies the file is there — it does not
# download. Used for the main model, which the coordinator/worker cannot
# run without.
ensure_file() {
  local path="$1"
  if [ -f "${path}" ]; then
    return 0
  fi
  echo "ERROR: ${path} not found." >&2
  echo "       Re-run the ds4-deepseek-v4-flash-mtp playbook to download it:" >&2
  echo "       ansible-playbook -i ansible/multi-node/inventory/hosts ansible/multi-node/ds4-deepseek-v4-flash-mtp.yml" >&2
  exit 1
}

case "${DS4_ROLE}" in
  head)
    [ -n "${DS4_HEAD_IP}" ] || { echo "DS4_HEAD_IP not set — re-run the track with the inventory group or -e ds4_head_ip=..." >&2; exit 1; }
    ensure_container
    ensure_file "${MODEL_PATH}"

    # MTP drafter is optional — degrade to a plain (non-speculative) launch
    # instead of blocking the whole model from serving.
    mtp_args=()
    if [ -f "${MTP_PATH}" ]; then
      mtp_args=(--mtp --mtp-model "${MTP_PATH}" --mtp-draft "${DS4_MTP_DRAFT}")
      mtp_status="MTP on"
    else
      echo "WARNING: MTP drafter not found at ${MTP_PATH} — starting WITHOUT" >&2
      echo "         speculative decoding. Re-run the playbook to fetch it:" >&2
      echo "         ansible-playbook -i ansible/multi-node/inventory/hosts ansible/multi-node/ds4-deepseek-v4-flash-mtp.yml" >&2
      mtp_status="MTP off — drafter missing"
    fi

    echo "Starting ds4 coordinator on ${DS4_HEAD_IP} (layers ${DS4_LAYERS_HEAD}, ${mtp_status}, pipeline port ${DS4_PP_PORT}, API port ${DS4_API_PORT}) ..."
    # First-run model load is slow (~153 GB mmap + weights); watch with:
    #   sudo podman logs -f ${CONTAINER}
    sudo podman exec -d "${CONTAINER}" "${SERVER}" \
      -m "${MODEL_PATH}" \
      --ctx "${DS4_CTX}" \
      "${mtp_args[@]}" \
      --role coordinator --layers "${DS4_LAYERS_HEAD}" \
      --listen "${DS4_HEAD_IP}" "${DS4_PP_PORT}" \
      --host 0.0.0.0 --port "${DS4_API_PORT}"

    echo "CLUSTER HEAD READY (when warm) — OpenAI endpoint: http://${DS4_HEAD_IP}:${DS4_API_PORT}/v1"
    echo "Health poll:  curl -s http://${DS4_HEAD_IP}:${DS4_API_PORT}/v1/models"
    echo "Logs:         sudo podman logs -f ${CONTAINER}"
    echo "NOTE: the worker joins lazily — start it on node 2 with DS4_ROLE=worker."
    ;;
  worker)
    [ -n "${DS4_HEAD_IP}" ] || { echo "DS4_HEAD_IP not set — re-run the track with the inventory group or -e ds4_head_ip=..." >&2; exit 1; }
    ensure_container
    ensure_file "${MODEL_PATH}"

    echo "Joining coordinator ${DS4_HEAD_IP}:${DS4_PP_PORT} as worker (layers ${DS4_LAYERS_WORKER}) ..."
    sudo podman exec -d "${CONTAINER}" "${SERVER}" \
      -m "${MODEL_PATH}" \
      --ctx "${DS4_CTX}" \
      --role worker --layers "${DS4_LAYERS_WORKER}" \
      --coordinator "${DS4_HEAD_IP}" "${DS4_PP_PORT}"

    echo "WORKER READY — watch the coordinator on the head: sudo podman logs -f ${CONTAINER}"
    echo "NOTE: the worker uses the SAME model/ctx as the head; it serves nothing directly."
    ;;
  *)
    echo "Unknown DS4_ROLE '${DS4_ROLE}'" >&2; exit 1 ;;
esac
