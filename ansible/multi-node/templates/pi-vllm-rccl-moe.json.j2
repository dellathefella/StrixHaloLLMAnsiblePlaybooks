{
  "providers": {
    "vllm-rccl-moe": {
      "name": "{{ vllm_moe_profiles[active_profile].display }} (vLLM + RCCL cluster, profile {{ active_profile }})",
      "baseUrl": "http://{{ vllm_moe_head_ansible_host }}:{{ vllm_moe_port }}/v1",
      "api": "openai-completions",
      "apiKey": "vllm-rccl-moe-local",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false{% if vllm_moe_profiles[active_profile].thinking_format is defined %},
        "thinkingFormat": "{{ vllm_moe_profiles[active_profile].thinking_format }}"{% endif %}
      },
      "models": [
        {
          "id": "{{ vllm_moe_profiles[active_profile].hf_repo }}",
          "name": "{{ vllm_moe_profiles[active_profile].display }} (cluster)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": {{ vllm_moe_profiles[active_profile].max_model_len }},
          "maxTokens": {{ vllm_moe_profiles[active_profile].max_tokens }},
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
  }
}
