#!/bin/bash
# =============================================================================
# ds4-deepseek-v41-flash-tp-start.sh — 2-node ds4 (DeepSeek V4.1 Flash) launch
#
# Generated by the ds4-deepseek-v41-flash-tp playbook ({{ ansible_date_time.iso8601 }}).
# Rendered on BOTH nodes; choose the role via env:
#   DS4_ROLE=worker  -> node 2 ({{ ds4_worker_host }}): TP worker, dials the
#                       coordinator on port {{ ds4_tp_port }}.  START THIS FIRST.
#   DS4_ROLE=head    -> node 1 ({{ ds4_head_host }}): TP coordinator, OpenAI /
#                       Anthropic API on port {{ ds4_api_port }}.
#
# Resident network tensor parallelism (--tensor-parallel, TCP transport): each
# rank holds half of every layer's routed experts; Engram rows are read from
# the local GGUF on demand. The TP channel rides the Thunderbolt link when
# setup-thunderbolt-net.yml brought it up.
#
# Binaries: the head runs ds4-server (HTTP API + TP coordinator); the worker
# runs the ds4 CLI — ds4-server refuses --role worker ("serving mode; start
# tensor-parallel workers with ./ds4"). The coordinator blocks in accept()
# until the worker dials in, so either may start first.
#
# If a ds4 process is already running in {{ ds4_cluster_name }}, the container is
# restarted first (one server per node). Server output goes to
# {{ ds4_log_dir }}/ds4-<role>.log on the host.
# =============================================================================
set -euo pipefail

DS4_ROLE="${DS4_ROLE:?set DS4_ROLE=worker|head}"

DS4_MODELS_DIR="${DS4_MODELS_DIR:-{{ ds4_models_dir }}}"
DS4_MODEL_FILE="${DS4_MODEL_FILE:-{{ ds4_model_file }}}"
DS4_LOG_DIR="${DS4_LOG_DIR:-{{ ds4_log_dir }}}"
DS4_CTX="${DS4_CTX:-{{ ds4_ctx }}}"
DS4_TP_PORT="${DS4_TP_PORT:-{{ ds4_tp_port }}}"
DS4_API_PORT="${DS4_API_PORT:-{{ ds4_api_port }}}"
DS4_MAX_TOKENS="${DS4_MAX_TOKENS:-{{ ds4_max_tokens }}}"
DS4_HEAD_IP="${DS4_HEAD_IP:-{{ ds4_head_ip }}}"
DS4_EXTRA_ARGS="${DS4_EXTRA_ARGS:-}"
CONTAINER="{{ ds4_cluster_name }}"
SERVER="/usr/local/bin/ds4-server"   # head: API + coordinator
WORKER_BIN="/usr/local/bin/ds4"      # worker: TP worker loop
MODEL_PATH="${DS4_MODELS_DIR}/${DS4_MODEL_FILE}"
LOG="${DS4_LOG_DIR}/ds4-${DS4_ROLE}.log"

SUDO=""
[ "$(id -u)" -eq 0 ] || SUDO="sudo"

[ -n "${DS4_HEAD_IP}" ] || { echo "DS4_HEAD_IP not set — re-run the playbook or export DS4_HEAD_IP=..." >&2; exit 1; }
[ -f "${MODEL_PATH}" ] || {
  echo "ERROR: ${MODEL_PATH} not found — re-run:" >&2
  echo "  ansible-playbook -i ansible/multi-node/inventory/hosts ansible/multi-node/ds4-deepseek-v41-flash-tp.yml" >&2
  exit 1
}

if [ "$(${SUDO} podman ps --filter name=^${CONTAINER}$ --format '{{ '{{.Names}}' }}')" != "${CONTAINER}" ]; then
  echo "Starting container ${CONTAINER} ..." >&2
  ${SUDO} podman start "${CONTAINER}" >/dev/null
elif ${SUDO} podman top "${CONTAINER}" args 2>/dev/null | grep -qE '/usr/local/bin/ds4(-server)? '; then
  echo "ds4 already running in ${CONTAINER} — restarting the container ..." >&2
  ${SUDO} podman restart -t 5 "${CONTAINER}" >/dev/null
fi

common=(-m "${MODEL_PATH}" --rocm --ctx "${DS4_CTX}" --tensor-parallel --transport tcp)

case "${DS4_ROLE}" in
  worker)
    BIN="${WORKER_BIN}"
    args=("${common[@]}" --role worker --coordinator "${DS4_HEAD_IP}" "${DS4_TP_PORT}")
    ;;
  head)
    BIN="${SERVER}"
    args=("${common[@]}" --role coordinator --listen "${DS4_HEAD_IP}" "${DS4_TP_PORT}"
          --host 0.0.0.0 --port "${DS4_API_PORT}" -n "${DS4_MAX_TOKENS}")
    ;;
  *)
    echo "Unknown DS4_ROLE '${DS4_ROLE}' (worker|head)" >&2; exit 1 ;;
esac
# shellcheck disable=SC2206
[ -z "${DS4_EXTRA_ARGS}" ] || args+=(${DS4_EXTRA_ARGS})

cmd="exec ${BIN}$(printf ' %q' "${args[@]}") >> $(printf '%q' "${LOG}") 2>&1"
echo "=== $(date -Is) ${DS4_ROLE}: ${BIN} ${args[*]}" >> "${LOG}"
${SUDO} podman exec -d "${CONTAINER}" /bin/bash -c "${cmd}"

echo "${DS4_ROLE} started — log: ${LOG}"
if [ "${DS4_ROLE}" = head ]; then
  echo "API (when loaded): http://${DS4_HEAD_IP}:${DS4_API_PORT}/v1   (curl -s localhost:${DS4_API_PORT}/v1/models)"
else
  echo "Now start the coordinator on {{ ds4_head_host }}: DS4_ROLE=head ~/scripts/ds4-deepseek-v41-flash-tp-start.sh"
fi
